// Shared WeiDU helpers for the BG 2024 Rules Mod.

// 2024 ability modifier: (score - 10) / 2, rounded down.
DEFINE_PATCH_FUNCTION b24_ability_mod
  INT_VAR score = 10
  RET mod
BEGIN
  PATCH_IF (score >= 10) BEGIN
    SET mod = (score - 10) / 2
  END ELSE BEGIN
    SET mod = 0 - ((11 - score) / 2)
  END
END

// Proficiency bonus by level (+2 at 1 to +6 at 17). Monsters follow the CR table up to +9.
DEFINE_PATCH_FUNCTION b24_prof_bonus
  INT_VAR level = 1
          max_level = 20
  RET prof
BEGIN
  SET lvl = (level < 1) ? 1 : level
  SET lvl = (lvl > max_level) ? max_level : lvl
  SET prof = 2 + ((lvl - 1) / 4)
END

// Returns the SPLSTATE.IDS value for name, appending a new entry on a free value if needed.
// Values up to 255 are used first; beyond that EEex (>= v1.2.0) is required.
DEFINE_ACTION_FUNCTION b24_spell_state
  STR_VAR name = ~~
  RET id
BEGIN
  OUTER_SET id = IDS_OF_SYMBOL (~splstate~ ~%name%~)
  ACTION_IF (id < 0) BEGIN
    COPY_EXISTING ~splstate.ids~ ~override~
      SET id = 0 - 1
      FOR (n = 0; (n < 1024) AND (id < 0); ++n) BEGIN
        PATCH_IF (INDEX_BUFFER (EVALUATE_REGEXP ~^[ %TAB%]*%n%[ %TAB%]~) < 0) BEGIN
          SET id = n
        END
      END
      PATCH_IF (id < 0) BEGIN
        PATCH_FAIL ~No free SPLSTATE.IDS value for %name%~
      END
      SET len = BUFFER_LENGTH
      READ_BYTE (len - 1) last
      SPRINT line ~%id% %name%%WNL%~
      PATCH_IF (last != 10) BEGIN
        SPRINT line ~%WNL%%line%~
      END
      INSERT_BYTES len (STRING_LENGTH ~%line%~)
      WRITE_ASCIIE len ~%line%~
    CLEAR_IDS_MAP
  END
END

// Creates a self-targeted innate ability (SPL V1) with one ability and one effect.
DEFINE_ACTION_FUNCTION b24_create_innate
  INT_VAR name = 0 - 1
          description = 0 - 1
          opcode = 0
          parameter1 = 0
          parameter2 = 0
          timing = 0                   // instant: a permanent op402 reruns whenever effects are re-evaluated
          touch = 0                    // 1: targets a creature instead of the caster
          range = 0                    // with touch: range (0 = touch range)
  STR_VAR resref = ~~
          icon = ~~
          effect_res = ~~
BEGIN
  // Any vanilla spell serves as the file to overwrite; every byte is rewritten below. SPPR103
  // (a touch spell) also gives the touch range.
  COPY_EXISTING ~sppr103.spl~ ~override/%resref%.spl~
    READ_LONG 0x64 src_hdr
    READ_SHORT (src_hdr + 0x0e) touch_range
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 0x72
    WRITE_ASCII 0x00 ~SPL V1  ~ #8
    WRITE_LONG  0x08 name
    WRITE_LONG  0x0c (0 - 1)
    WRITE_LONG  0x18 0x4000              // ignore wild surges / dead magic
    WRITE_SHORT 0x1c 4                   // innate
    WRITE_LONG  0x34 1                   // level
    WRITE_ASCIIE 0x3a ~%icon%~ #8
    WRITE_LONG  0x50 description
    WRITE_LONG  0x54 (0 - 1)
    INSERT_BYTES 0x72 (0x28 + 0x30)
    WRITE_LONG  0x64 0x72                // one extended header
    WRITE_SHORT 0x68 1
    WRITE_LONG  0x6a (0x72 + 0x28)       // feature blocks
    WRITE_SHORT 0x6e 0
    WRITE_SHORT 0x70 0
    SET h = 0x72
    WRITE_BYTE  (h + 0x00) 1             // standard spell form
    WRITE_SHORT (h + 0x02) 4             // innate location
    WRITE_ASCIIE (h + 0x04) ~%icon%~ #8
    WRITE_BYTE  (h + 0x0c) (touch ? 1 : 5) // target: creature or caster
    WRITE_SHORT (h + 0x0e) (touch ? ((range > 0) ? range : touch_range) : 0)
    WRITE_SHORT (h + 0x10) 1             // level required
    WRITE_SHORT (h + 0x1e) 1             // one feature block
    WRITE_SHORT (h + 0x20) 0
    WRITE_SHORT (h + 0x26) 1             // no projectile
    SET f = 0x72 + 0x28
    WRITE_SHORT (f + 0x00) opcode
    WRITE_BYTE  (f + 0x02) (touch ? 2 : 1) // target: preset target or self
    WRITE_LONG  (f + 0x04) parameter1
    WRITE_LONG  (f + 0x08) parameter2
    WRITE_BYTE  (f + 0x0c) timing
    WRITE_BYTE  (f + 0x12) 100           // probability
    WRITE_ASCIIE (f + 0x14) ~%effect_res%~ #8
END

// Creates a spell whose effect is a Lua function (op402): cantrips (innate), new wizard or priest
// spells. type: 1 wizard, 2 priest, 4 innate; target: 1 creature, 5 caster; param1/param2/special
// reach the Lua function through the op402 effect. lists (priest spells): C and/or D.
DEFINE_ACTION_FUNCTION b24_create_lua_spell
  INT_VAR name = 0 - 1
          description = 0 - 1
          type = 4
          level = 1
          target = 1
          range = 60
          projectile = 1
          cast_anim = 0
          parameter1 = 0
          parameter2 = 0
          special = 0
  STR_VAR resref = ~~
          icon = ~~
          function = ~~
          lists = ~~
BEGIN
  COPY_EXISTING ~sppr103.spl~ ~override/%resref%.spl~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 (0x72 + 0x28 + 0x30)
    WRITE_ASCII 0x00 ~SPL V1  ~ #8
    WRITE_LONG  0x08 name
    WRITE_LONG  0x0c (0 - 1)
    WRITE_LONG  0x18 0x4000
    WRITE_SHORT 0x1c type
    WRITE_SHORT 0x22 cast_anim
    WRITE_LONG  0x34 level
    WRITE_ASCIIE 0x3a ~%icon%~ #8
    WRITE_LONG  0x50 description
    WRITE_LONG  0x54 (0 - 1)
    WRITE_LONG  0x64 0x72
    WRITE_SHORT 0x68 1
    WRITE_LONG  0x6a (0x72 + 0x28)
    SET h = 0x72
    WRITE_BYTE  (h + 0x00) 1
    WRITE_SHORT (h + 0x02) ((type == 4) ? 4 : 2)
    WRITE_ASCIIE (h + 0x04) ~%icon%~ #8
    WRITE_BYTE  (h + 0x0c) target
    WRITE_SHORT (h + 0x0e) ((target == 5) ? 0 : range)
    WRITE_SHORT (h + 0x10) 1
    WRITE_SHORT (h + 0x12) 1
    WRITE_SHORT (h + 0x1e) 1
    WRITE_SHORT (h + 0x20) 0
    WRITE_SHORT (h + 0x26) projectile
    SET f = 0x72 + 0x28
    WRITE_SHORT (f + 0x00) 402
    WRITE_BYTE  (f + 0x02) ((target == 5) ? 1 : 2)
    WRITE_LONG  (f + 0x04) parameter1
    WRITE_LONG  (f + 0x08) parameter2
    WRITE_BYTE  (f + 0x0c) 0
    WRITE_BYTE  (f + 0x12) 100
    WRITE_ASCIIE (f + 0x14) ~%function%~ #8
    WRITE_LONG  (f + 0x2c) special
    PATCH_IF (type == 2) BEGIN
      SET excl = 0
      SET cleric = (INDEX (~C~ ~%lists%~) >= 0) ? 1 : 0
      SET druid = (INDEX (~D~ ~%lists%~) >= 0) ? 1 : 0
      PATCH_IF (cleric AND NOT druid) BEGIN SET excl = 0x80000000 END
      PATCH_IF (druid AND NOT cleric) BEGIN SET excl = 0x40000000 END
      WRITE_LONG 0x1e excl
    END
END

// Gives a spell made by b24_create_lua_spell the look of a vanilla spell (model): its casting
// sound, the visual, lighting and sound effects of its first ability (opcodes 215, 141, 174; only
// those whose files exist in this game) and, with projectile = 1, its projectile. Only models
// that hit one creature may lend their projectile: the Lua function expects one target.
DEFINE_ACTION_FUNCTION b24_spell_look
  INT_VAR projectile = 0
  STR_VAR resref = ~~
          model = ~~
BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%model%.spl~ AND FILE_EXISTS_IN_GAME ~%resref%.spl~ BEGIN
    OUTER_SET look_n = 0
    COPY_EXISTING ~%model%.spl~ ~override~
      READ_ASCII 0x10 look_sound (8) NULL
      READ_LONG 0x64 hoff
      READ_LONG 0x6a foff
      READ_SHORT (hoff + 0x26) look_projectile
      READ_SHORT (hoff + 0x1e) fn
      READ_SHORT (hoff + 0x20) fi
      FOR (k = 0; k < fn; ++k) BEGIN
        SET o = foff + (fi + k) * 0x30
        READ_SHORT o op
        READ_ASCII (o + 0x14) fx_res (8) NULL
        SET keep = (op == 141)
        PATCH_IF ((op == 174) AND (FILE_EXISTS_IN_GAME ~%fx_res%.wav~)) BEGIN SET keep = 1 END
        PATCH_IF ((op == 215) AND ((FILE_EXISTS_IN_GAME ~%fx_res%.vvc~) OR (FILE_EXISTS_IN_GAME ~%fx_res%.bam~))) BEGIN
          SET keep = 1
        END
        PATCH_IF keep BEGIN
          READ_ASCII o $look_fx(~%look_n%~) (0x30)
          SET look_n += 1
        END
      END
    BUT_ONLY
    COPY_EXISTING ~%resref%.spl~ ~override~
      PATCH_IF (~%look_sound%~ STRING_COMPARE_CASE ~~) BEGIN
        WRITE_ASCIIE 0x10 ~%look_sound%~ #8
      END
      READ_LONG 0x64 hoff
      READ_LONG 0x6a foff
      PATCH_IF projectile BEGIN
        WRITE_SHORT (hoff + 0x26) look_projectile
      END
      READ_SHORT (hoff + 0x1e) fn
      READ_SHORT (hoff + 0x20) fi
      // The spell's own effects end the file: the borrowed ones go after them.
      SET at = foff + (fi + fn) * 0x30
      FOR (k = 0; k < look_n; ++k) BEGIN
        INSERT_BYTES at 0x30
        WRITE_ASCIIE at $look_fx(~%k%~) (0x30)
        SET at += 0x30
      END
      WRITE_SHORT (hoff + 0x1e) (fn + look_n)
    BUT_ONLY
  END
END

// Creates an innate cone attack (Dragonborn Breath Weapon): one damage effect per tier, 1d10 at
// level 1, 2d10 at 5, 3d10 at 11, 4d10 at 17, Dexterity save (engine breath save) for half. The
// cone projectile, target type and range come from Burning Hands (SPWI103).
DEFINE_ACTION_FUNCTION b24_create_breath
  INT_VAR name = 0 - 1
          description = 0 - 1
          damage_type = 0              // op12 parameter 2
  STR_VAR resref = ~~
          icon = ~~
BEGIN
  COPY_EXISTING ~spwi103.spl~ ~override/%resref%.spl~
    READ_LONG  0x64 src_hdr
    READ_BYTE  (src_hdr + 0x0c) src_target
    READ_SHORT (src_hdr + 0x0e) src_range
    READ_SHORT (src_hdr + 0x26) src_projectile
    READ_SHORT 0x22 src_cast_anim
    DELETE_BYTES 0 BUFFER_LENGTH
    SET tiers = 4
    SET hdr = 0x72
    SET fx = hdr + tiers * 0x28
    INSERT_BYTES 0 (fx + tiers * 0x30)
    WRITE_ASCII 0x00 ~SPL V1  ~ #8
    WRITE_LONG  0x08 name
    WRITE_LONG  0x0c (0 - 1)
    WRITE_LONG  0x18 0x4000              // ignore wild surges / dead magic
    WRITE_SHORT 0x1c 4                   // innate
    WRITE_SHORT 0x22 src_cast_anim
    WRITE_LONG  0x34 1
    WRITE_ASCIIE 0x3a ~%icon%~ #8
    WRITE_LONG  0x50 description
    WRITE_LONG  0x54 (0 - 1)
    WRITE_LONG  0x64 hdr
    WRITE_SHORT 0x68 tiers
    WRITE_LONG  0x6a fx
    FOR (t = 0; t < tiers; ++t) BEGIN
      SET h = hdr + t * 0x28
      WRITE_BYTE  (h + 0x00) 1
      WRITE_SHORT (h + 0x02) 4
      WRITE_ASCIIE (h + 0x04) ~%icon%~ #8
      WRITE_BYTE  (h + 0x0c) src_target
      WRITE_SHORT (h + 0x0e) src_range
      WRITE_SHORT (h + 0x10) ((t == 0) ? 1 : (t == 1) ? 5 : (t == 2) ? 11 : 17)
      WRITE_SHORT (h + 0x1e) 1
      WRITE_SHORT (h + 0x20) t
      WRITE_SHORT (h + 0x26) src_projectile
      SET f = fx + t * 0x30
      WRITE_SHORT (f + 0x00) 12          // damage
      WRITE_BYTE  (f + 0x02) 2           // preset target
      WRITE_LONG  (f + 0x08) damage_type
      WRITE_BYTE  (f + 0x0c) 1           // instant
      WRITE_BYTE  (f + 0x12) 100
      WRITE_LONG  (f + 0x1c) (t + 1)     // dice
      WRITE_LONG  (f + 0x20) 10
      WRITE_LONG  (f + 0x24) 0x02        // breath save (Dexterity in this mod)
      WRITE_LONG  (f + 0x2c) 0x100       // save for half
    END
END

// Sets every entry of a 2DA column to value.
DEFINE_PATCH_FUNCTION b24_set_2da_column
  INT_VAR column = 1
          req_cols = 2
          value = 0
BEGIN
  COUNT_2DA_ROWS req_cols rows
  FOR (r = 0; r < rows; ++r) BEGIN
    SET_2DA_ENTRY r column req_cols value
  END
END

// The mod's popups use BG1's character creation window (GUICGWDE) and buttons (GUIBUTMT). BG2:EE
// has neither: there they get an opaque panel and BG2's own button art.
DEFINE_ACTION_FUNCTION b24_menu_for_game
  STR_VAR file = ~~
BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~guicgwde.mos~ BEGIN
    COPY_EXISTING ~%file%~ ~override~
      REPLACE_TEXTUALLY EXACT_MATCH ~mosaic GUICGWDE~ ~fill 30 24 18 255~
      REPLACE_TEXTUALLY EXACT_MATCH ~bam GUIBUTMT~ ~bam GUIOSTUM~
      BUT_ONLY
  END
END

// The mod's own icons (tools/png2bam.pl): icons/<RESREF>.bam becomes the icon of the spell or
// innate RESREF, as the game's own spells show theirs: the glyph alone in the spellbook and the
// description, on a stone on the action bar (icons/B2B*.bam, tools/stone-icons.pl). Spells of the
// mod that borrow a game icon get its two versions the same way: C in the spellbook and the
// description, B on the action bar.
// Every component that creates spells calls this at its end; spells another component creates
// later get their icon when that one runs.
DEFINE_ACTION_FUNCTION b24_install_icons
BEGIN
  COPY_EXISTING_REGEXP GLOB ~^B24.+\.spl$~ ~override~
    READ_ASCII 0x3a b24_icon (8) NULL
    TO_UPPER b24_icon
    PATCH_IF (~%b24_icon%~ STRING_MATCHES_REGEXP ~^\(B24\|B2B\).*~ != 0)
      AND (~%b24_icon%~ STRING_MATCHES_REGEXP ~^.+[BC]$~ = 0) BEGIN
      INNER_PATCH_SAVE b24_base ~%b24_icon%~ BEGIN REPLACE_TEXTUALLY ~[BC]$~ ~~ END
      PATCH_IF FILE_EXISTS_IN_GAME ~%b24_base%C.bam~ BEGIN
        WRITE_ASCIIE 0x3a ~%b24_base%C~ #8
      END
      PATCH_IF FILE_EXISTS_IN_GAME ~%b24_base%B.bam~ BEGIN
        READ_LONG  0x64 hoff
        READ_SHORT 0x68 hnum
        FOR (h = 0; h < hnum; ++h) BEGIN
          WRITE_ASCIIE (hoff + h * 0x28 + 0x04) ~%b24_base%B~ #8
        END
      END
    END
  BUT_ONLY
  ACTION_BASH_FOR ~bg2024/icons~ ~^.+\.bam$~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%BASH_FOR_RES%.spl~ BEGIN
      COPY ~%BASH_FOR_FILESPEC%~ ~override~
      // The action bar's glyph on a stone (icons/B2B*.bam), where there is one.
      OUTER_SPRINT b24_bar ~%BASH_FOR_RES%~
      OUTER_PATCH_SAVE b24_stone ~%BASH_FOR_RES%~ BEGIN REPLACE_TEXTUALLY CASE_INSENSITIVE ~^B24~ ~B2B~ END
      ACTION_IF FILE_EXISTS ~bg2024/icons/%b24_stone%.bam~ BEGIN
        COPY ~bg2024/icons/%b24_stone%.bam~ ~override~
        OUTER_SPRINT b24_bar ~%b24_stone%~
      END
      COPY_EXISTING ~%BASH_FOR_RES%.spl~ ~override~
        WRITE_ASCIIE 0x3a ~%BASH_FOR_RES%~ #8
        READ_LONG  0x64 hoff
        READ_SHORT 0x68 hnum
        FOR (h = 0; h < hnum; ++h) BEGIN
          WRITE_ASCIIE (hoff + h * 0x28 + 0x04) ~%b24_bar%~ #8
        END
      BUT_ONLY
    END
  END
END

// Portrait icon of one of the mod's states: a STATDESC.2DA row with the state's name (shown over the
// icon) and its own icon, portraits/<BAM>.bam (13x13, tools/png2bam.pl --portrait). A reinstall
// reuses the row that already shows this BAM. Returns the icon number for opcode 142.
DEFINE_ACTION_FUNCTION b24_portrait_icon
  INT_VAR name = 0 - 1
  STR_VAR bam = ~~
  RET icon
BEGIN
  COPY ~bg2024/portraits/%bam%.bam~ ~override~
  OUTER_SET icon = 0 - 1
  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 rows
    SET last = 0 - 1
    FOR (r = 0; r < rows; ++r) BEGIN
      READ_2DA_ENTRY r 0 3 label
      READ_2DA_ENTRY r 2 3 file
      PATCH_IF (~%file%~ STRING_EQUAL_CASE ~%bam%~) BEGIN
        SET icon = label
        SET_2DA_ENTRY r 1 3 name
      END
      PATCH_IF (IS_AN_INT label) BEGIN
        PATCH_IF (label > last) BEGIN SET last = label END
      END
    END
    PATCH_IF (icon < 0) BEGIN
      SET icon = last + 1
      INSERT_2DA_ROW rows 3 ~%icon% %name% %bam%~
    END
    BUT_ONLY
END
