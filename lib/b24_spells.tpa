// Spells component: 2024 spell slots, the spell catalog (tables/b24spell.2da), upcast versions,
// cantrips and new 2024 spells (lua/B24SPELL.lua).
//
// Catalog actions: SRD (a 2024 spell: level, lists, concentration, save, dice, upcasting, name),
// KEEP (non-SRD spell with a 2024 counterpart: level only), DROP (BG-only spell: hidden from
// spell selection and priest lists, scrolls no longer teach it).
// Priest spells stop at level 7 in the engine: 8th and 9th level priest spells sit at 7, and the
// 2024 8th/9th slots count as extra 7th level slots (tables/b24_mxsplprs.2da, b24_mxspldru.2da).
// Paladins and Rangers use the cleric and druid spells (the engine shares the priest lists).

// 2024 spell slots, no bonus slots for high Wisdom, sorcerer spells known = 2024 prepared spells.
ACTION_FOR_EACH b24_table IN ~mxsplwiz~ ~mxsplsrc~ ~mxsplbrd~ ~mxsplprs~ ~mxspldru~ ~mxsplpal~ ~mxsplran~ ~splsrckn~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_table%.2da~ BEGIN
    COPY ~bg2024/tables/b24_%b24_table%.2da~ ~override/%b24_table%.2da~
  END
END
// The Dragon Disciple kit (BG2) has its own slot table; as Draconic Sorcery it casts like any
// sorcerer.
ACTION_IF FILE_EXISTS_IN_GAME ~mxspldd.2da~ BEGIN
  COPY ~bg2024/tables/b24_mxsplsrc.2da~ ~override/mxspldd.2da~
END
COPY_EXISTING ~mxsplwis.2da~ ~override~
  COUNT_2DA_COLS b24_cols
  FOR (c = 1; c < b24_cols; ++c) BEGIN
    LPF b24_set_2da_column INT_VAR column = c req_cols = b24_cols value = 0 END
  END
  BUT_ONLY
// No Intelligence caps on the spellbook (2024 has none): BG limits the highest spell level a wizard
// can learn and the spells known per level by INT (INT 17: level 8 at most, 14 per level; upcast
// copies count), which the Spellbook choice (B24WIZ.lua) offers up to level 9.
COPY_EXISTING ~intmod.2da~ ~override~
  COUNT_2DA_COLS b24_cols
  LPF b24_set_2da_column INT_VAR column = 2 req_cols = b24_cols value = 9 END
  LPF b24_set_2da_column INT_VAR column = 3 req_cols = b24_cols value = 99 END
  BUT_ONLY

// Spells whose 2024 casting time is longer than an action (rituals, minutes, hours).
ACTION_FOR_EACH b24_res IN ~SPWI110~ ~SPWI123~ ~SPWI301~ ~SPWI617~ ~SPWI804~ ~SPPR304~ ~SPPR504~ ~SPPR712~ BEGIN
  OUTER_SET $b24_slow_cast(~%b24_res%~) = 1
END

// Damage and healing in a spell: op12 dice (and flat damage) in every extended header; healing
// (op17) becomes a Lua heal (B24HEAL in B24SPELL.lua: dice + casting ability modifier).
DEFINE_PATCH_FUNCTION b24_spell_numbers
  INT_VAR dice_n = 0 dice_s = 0 flat = 0 heal = 0
BEGIN
  READ_LONG  0x64 hdr_off
  READ_SHORT 0x68 hdr_num
  READ_LONG  0x6a fx_off
  FOR (h = 0; h < hdr_num; ++h) BEGIN
    READ_SHORT (hdr_off + h * 0x28 + 0x1e) fx_num
    READ_SHORT (hdr_off + h * 0x28 + 0x20) fx_idx
    FOR (k = 0; k < fx_num; ++k) BEGIN
      SET f = fx_off + (fx_idx + k) * 0x30
      READ_SHORT f opcode
      READ_ASCII (f + 0x14) fx_res (8) NULL
      PATCH_IF (heal AND (opcode == 402) AND (~%fx_res%~ STRING_EQUAL_CASE ~B24HEAL~)) BEGIN
        // Upcast copies of a spell already converted below.
        WRITE_LONG (f + 0x04) dice_n
        WRITE_LONG (f + 0x08) dice_s
        WRITE_LONG (f + 0x2c) flat
      END ELSE PATCH_IF (heal AND (opcode == 17)) BEGIN
        WRITE_SHORT f 402
        WRITE_LONG  (f + 0x04) dice_n
        WRITE_LONG  (f + 0x08) dice_s
        WRITE_BYTE  (f + 0x0c) 0
        WRITE_LONG  (f + 0x0e) 0
        WRITE_ASCII (f + 0x14) ~B24HEAL~ #8
        WRITE_LONG  (f + 0x1c) 0
        WRITE_LONG  (f + 0x20) 0
        WRITE_LONG  (f + 0x2c) flat
      END ELSE PATCH_IF ((NOT heal) AND (opcode == 402) AND ((~%fx_res%~ STRING_EQUAL_CASE ~B24SATK~)
          OR (~%fx_res%~ STRING_EQUAL_CASE ~B24RAYS~) OR (~%fx_res%~ STRING_EQUAL_CASE ~B24DART~))) BEGIN
        // Spell attacks (B24SATK in B24SPELL.lua): parameter 1 dice, parameter 2 die size. Scorching
        // Ray (B24RAYS): rays, die size, dice per ray. Magic Missile (B24DART): darts, die size,
        // flat damage per dart.
        WRITE_LONG (f + 0x04) dice_n
        WRITE_LONG (f + 0x08) dice_s
        WRITE_LONG (f + 0x2c) flat
      END ELSE PATCH_IF ((NOT heal) AND (opcode == 12)) BEGIN
        WRITE_LONG (f + 0x04) flat
        WRITE_LONG (f + 0x1c) dice_n
        WRITE_LONG (f + 0x20) dice_s
      END
    END
  END
END

// Splits "8d6+40" / "H2d8" / "F70" into dice count, die size, flat amount, healing.
DEFINE_PATCH_FUNCTION b24_parse_dice
  STR_VAR text = ~-~
  RET dice_n dice_s flat heal
BEGIN
  SET dice_n = 0 SET dice_s = 0 SET flat = 0 SET heal = 0
  TEXT_SPRINT rest ~%text%~
  PATCH_IF (~%rest%~ STRING_MATCHES_REGEXP ~^[HF].*~ = 0) BEGIN
    SET heal = 1
    PATCH_IF (~%rest%~ STRING_MATCHES_REGEXP ~^F.*~ = 0) BEGIN
      INNER_PATCH_SAVE rest ~%rest%~ BEGIN REPLACE_TEXTUALLY ~^F~ ~~ END
      SET flat = rest
      TEXT_SPRINT rest ~~
    END ELSE BEGIN
      INNER_PATCH_SAVE rest ~%rest%~ BEGIN REPLACE_TEXTUALLY ~^H~ ~~ END
    END
  END
  // An optional "+N" is split off first (an unmatched optional regex group gives no usable MATCH).
  PATCH_IF (INDEX (~+~ ~%rest%~) >= 0) BEGIN
    INNER_PATCH_SAVE plus ~%rest%~ BEGIN REPLACE_TEXTUALLY ~^[^+]*[+]~ ~~ END
    INNER_PATCH_SAVE rest ~%rest%~ BEGIN REPLACE_TEXTUALLY ~[+].*$~ ~~ END
    SET flat = plus
  END
  PATCH_IF (~%rest%~ STRING_MATCHES_REGEXP ~^[0-9]+d[0-9]+$~ = 0) BEGIN
    INNER_PATCH_SAVE dice_text ~%rest%~ BEGIN REPLACE_TEXTUALLY ~d.*$~ ~~ END
    SET dice_n = dice_text
    INNER_PATCH_SAVE dice_text ~%rest%~ BEGIN REPLACE_TEXTUALLY ~^[0-9]+d~ ~~ END
    SET dice_s = dice_text
  END
END

// Priest spells: the cleric/druid lists through the exclusion flags (bit 30: not for clerics and
// paladins, bit 31: not for druids and rangers).
DEFINE_PATCH_FUNCTION b24_priest_lists
  STR_VAR lists = ~~
BEGIN
  READ_LONG 0x1e excl
  SET excl = excl BAND 0x3fffffff
  SET cleric = (INDEX (~C~ ~%lists%~) >= 0) ? 1 : 0
  SET druid = (INDEX (~D~ ~%lists%~) >= 0) ? 1 : 0
  PATCH_IF (cleric AND NOT druid) BEGIN SET excl = excl BOR 0x80000000 END
  PATCH_IF (druid AND NOT cleric) BEGIN SET excl = excl BOR 0x40000000 END
  WRITE_LONG 0x1e excl
END

// Arcane upcast versions and their base spell, read by B24SPELL.lua (filled below).
COPY ~bg2024/tables/b24upcst.2da~ ~override~

// 2e buffs with 2024 numbers (before the catalog loop, so upcast versions inherit them).
// Bless: +1d4 to attack rolls and saves (in BG +2 to both).
ACTION_IF FILE_EXISTS_IN_GAME ~sppr101.spl~ BEGIN
  COPY_EXISTING ~sppr101.spl~ ~override~
    LPF ALTER_EFFECT INT_VAR match_opcode = 130 parameter1 = 2 END
    LPF CLONE_EFFECT INT_VAR match_opcode = 130 opcode = 325 parameter1 = 2 parameter2 = 0 END
    BUT_ONLY
END
// Dispel Magic (2024): one creature instead of BG's area; BG's dispel (op58, a caster level roll)
// and its haste/slow/icon cures give way to B24DISPL in B24SPELL.lua, which ends the target's
// spells up to the slot level and checks against higher ones. Its effect lands on the caster, so
// BG's spell protections on the target don't stop it. The message, the visual and the end of
// magically summoned creatures stay. Upcast versions (catalog 1d1) inherit this.
ACTION_FOR_EACH b24_res IN ~spwi302~ ~sppr303~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_res%.spl~ BEGIN
    COPY_EXISTING ~%b24_res%.spl~ ~override~
      LPF ALTER_SPELL_HEADER INT_VAR target = 1 target_count = 0 projectile = 1 END
      LPF DELETE_EFFECT INT_VAR match_opcode = 58 END
      LPF DELETE_EFFECT INT_VAR match_opcode = 81 END
      LPF DELETE_EFFECT INT_VAR match_opcode = 77 END
      LPF DELETE_EFFECT INT_VAR match_opcode = 240 END
      LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 1 timing = 1 duration = 0 probability1 = 100 STR_VAR resource = ~B24DISPL~ END
      BUT_ONLY
  END
END

// Mage Armor: base AC 13 + Dexterity (BG 6 = AC 14).
ACTION_IF FILE_EXISTS_IN_GAME ~spwi102.spl~ BEGIN
  COPY_EXISTING ~spwi102.spl~ ~override~
    LPF ALTER_EFFECT INT_VAR match_opcode = 0 match_parameter2 = 16 parameter1 = 7 END
    BUT_ONLY
END
// Barkskin: AC can't be lower than 17 (B24SPELL.lua; the set-base-AC effect stays as a neutral
// marker, base 10), no save bonuses.
ACTION_IF FILE_EXISTS_IN_GAME ~sppr202.spl~ BEGIN
  COPY_EXISTING ~sppr202.spl~ ~override~
    LPF ALTER_EFFECT INT_VAR match_opcode = 0 match_parameter2 = 16 parameter1 = 10 END
    FOR (b24_op = 33; b24_op <= 37; ++b24_op) BEGIN
      LPF DELETE_EFFECT INT_VAR match_opcode = b24_op END
    END
    BUT_ONLY
END
// Shield: +5 AC until the start of your next round, with the Magic Missile immunity.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi114.spl~ BEGIN
  COPY_EXISTING ~spwi114.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 0 match_parameter2 = 2 END
    LPF ALTER_EFFECT INT_VAR match_opcode = 0 match_parameter2 = 16 parameter1 = 5 parameter2 = 0 END
    LPF ALTER_EFFECT INT_VAR match_timing = 0 duration = 6 END
    BUT_ONLY
END
// Blur: attacks against you have disadvantage (B24SPELL.lua reads the blur effect, op65), no AC
// or save bonuses.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi201.spl~ BEGIN
  COPY_EXISTING ~spwi201.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 0 END
    FOR (b24_op = 33; b24_op <= 37; ++b24_op) BEGIN
      LPF DELETE_EFFECT INT_VAR match_opcode = b24_op END
    END
    BUT_ONLY
END
// Slow: -2 AC instead of -4 AC and -4 to attack rolls (speed and attacks stay halved).
ACTION_IF FILE_EXISTS_IN_GAME ~spwi312.spl~ BEGIN
  COPY_EXISTING ~spwi312.spl~ ~override~
    // ALTER_EFFECT takes negative values as "unchanged": the AC penalty is written directly.
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    READ_LONG  0x6a b24_foff
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      READ_SHORT (b24_hoff + h * 0x28 + 0x1e) b24_fnum
      READ_SHORT (b24_hoff + h * 0x28 + 0x20) b24_fidx
      FOR (k = 0; k < b24_fnum; ++k) BEGIN
        READ_SHORT (b24_foff + (b24_fidx + k) * 0x30) b24_op
        PATCH_IF (b24_op == 0) BEGIN WRITE_LONG (b24_foff + (b24_fidx + k) * 0x30 + 4) (0 - 2) END
      END
    END
    LPF DELETE_EFFECT INT_VAR match_opcode = 54 END
    BUT_ONLY
END
// Disintegrate: 10d6+40 force damage (BG magic damage), Dexterity save negates, instead of BG's
// instant death. The death effect becomes the damage effect with the same save flags; the catalog
// writes the dice.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi616.spl~ BEGIN
  COPY_EXISTING ~spwi616.spl~ ~override~
    LPF ALTER_EFFECT INT_VAR match_opcode = 238 opcode = 12 parameter1 = 0 parameter2 = 0x400000 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@744)
    BUT_ONLY
END
// Removes every effect of the spell but its looks and sounds: lighting (op141), colour glow (op61),
// sound (op174) and visual effect (op215). Everything else goes, also feedback strings (op139).
DEFINE_PATCH_FUNCTION b24_strip_effects
  STR_VAR keep = ~ 61 141 174 215 ~
BEGIN
  READ_LONG  0x64 b24_hoff
  READ_SHORT 0x68 b24_hnum
  READ_LONG  0x6a b24_foff
  CLEAR_ARRAY b24_strip
  FOR (h = 0; h < b24_hnum; ++h) BEGIN
    READ_SHORT (b24_hoff + h * 0x28 + 0x1e) b24_fnum
    READ_SHORT (b24_hoff + h * 0x28 + 0x20) b24_fidx
    FOR (k = 0; k < b24_fnum; ++k) BEGIN
      READ_SHORT (b24_foff + (b24_fidx + k) * 0x30) b24_op
      PATCH_IF (INDEX (~ %b24_op% ~ ~%keep%~) < 0) BEGIN SET $b24_strip(~%b24_op%~) = 1 END
    END
  END
  PHP_EACH b24_strip AS b24_op => b24_any BEGIN
    LPF DELETE_EFFECT INT_VAR match_opcode = b24_op END
  END
END

// Inflict Wounds: 2d10 necrotic damage (BG magic damage), Constitution save for half (the catalog
// writes dice and save), instead of BG's touch charge weapon. The spell targets a creature at
// touch range (Cure Light Wounds' range).
ACTION_IF FILE_EXISTS_IN_GAME ~sppr414.spl~ BEGIN
  COPY_EXISTING - ~sppr103.spl~ ~override~
    READ_LONG 0x64 b24_hoff
    READ_SHORT (b24_hoff + 0x0e) b24_touch_range
  COPY_EXISTING ~sppr414.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 111 END
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_BYTE  (b24_hoff + h * 0x28 + 0x0c) 1
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) b24_touch_range
    END
    // Save for half: save type spells (1) and special bit 8, as Fireball has it.
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 12 target = 2 timing = 1 probability1 = 100 parameter2 = 0x400000
      savingthrow = 1 special = 256 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@745)
    BUT_ONLY
END
// Harm: 14d6 necrotic damage (BG magic damage), Constitution save for half, at a creature within
// 60 feet, instead of BG's touch that leaves 1 hit point.
ACTION_IF FILE_EXISTS_IN_GAME ~sppr608.spl~ BEGIN
  COPY_EXISTING ~sppr608.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 111 END
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_BYTE  (b24_hoff + h * 0x28 + 0x0c) 1
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) 60
    END
    LPF ALTER_EFFECT INT_VAR target = 2 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 12 target = 2 timing = 1 probability1 = 100 parameter2 = 0x400000
      savingthrow = 1 special = 256 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@751)
    BUT_ONLY
END
// Flame Strike: 5d6 fire and 5d6 radiant damage (BG magic damage), Dexterity save for half; the
// catalog writes the same dice into both.
ACTION_IF FILE_EXISTS_IN_GAME ~sppr503.spl~ BEGIN
  COPY_EXISTING ~sppr503.spl~ ~override~
    LPF CLONE_EFFECT INT_VAR match_opcode = 12 parameter2 = 0x400000 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@752)
    BUT_ONLY
END
// Magic Missile: three darts of 1d4 + 1 force damage (BG magic damage), one more per spell level
// above 1 (B24DART in B24SPELL.lua; the catalog writes darts, die and flat damage). The
// single missile projectile shows the first dart (the others: B24MDART below).
ACTION_IF FILE_EXISTS_IN_GAME ~spwi112.spl~ BEGIN
  COPY_EXISTING ~spwi112.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 12 END
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x26) 68
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24DART~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@746)
    BUT_ONLY
END
// Chromatic Orb: a ranged spell attack for 3d8 damage of the kind the target resists least
// (B24SATK), instead of BG's level-based blinding, stunning and slaying.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi118.spl~ BEGIN
  COPY_EXISTING ~spwi118.spl~ ~override~
    LPF b24_strip_effects END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24SATK~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@747)
    BUT_ONLY
END
// Scorching Ray: three rays, each a ranged spell attack for 2d6 fire damage, one more ray per
// spell level above 2 (B24RAYS), instead of BG's one jet of flame; range 120 feet.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi217.spl~ BEGIN
  COPY_EXISTING ~spwi217.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 12 END
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) 120
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24RAYS~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@748)
    BUT_ONLY
END
// Acid Arrow: a ranged spell attack, 4d4 acid damage on a hit and 2d4 a round later, half the 4d4 on
// a miss (B24SATK), instead of BG's damage over rounds by caster level.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi211.spl~ BEGIN
  COPY_EXISTING ~spwi211.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 12 END
    LPF DELETE_EFFECT INT_VAR match_opcode = 142 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24SATK~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@749)
    BUT_ONLY
END
// Shield of Faith: +2 AC for 10 minutes (concentration, from the catalog) on a creature within 60
// feet, instead of BG's Armor of Faith damage resistance on the caster.
ACTION_IF FILE_EXISTS_IN_GAME ~sppr111.spl~ BEGIN
  COPY_EXISTING ~sppr111.spl~ ~override~
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_BYTE  (b24_hoff + h * 0x28 + 0x0c) 1
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) 60
    END
    LPF ALTER_EFFECT INT_VAR target = 2 END
    // Resistances (27-31, 84-89), the proficiency bonus (233) and the spell states (328).
    PATCH_FOR_EACH b24_op IN 27 28 29 30 31 84 85 86 87 88 89 233 328 BEGIN
      LPF DELETE_EFFECT INT_VAR match_opcode = b24_op END
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 0 target = 2 timing = 0 duration = 600 parameter1 = 2 probability1 = 100 END
    LPF ALTER_EFFECT INT_VAR match_opcode = 142 duration = 600 END
    LPF ALTER_EFFECT INT_VAR match_opcode = 174 match_timing = 4 duration = 600 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@750)
    BUT_ONLY
END
// Sleep and Color Spray: no hit dice limit (BG keeps it in the effects' dice fields). Sleep: the
// targets fall unconscious for a minute (Wisdom save, from the catalog). Color Spray: blinded for a
// round instead of asleep (Constitution save).
ACTION_FOR_EACH b24_res IN ~spwi116~ ~spwi105~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_res%.spl~ BEGIN
    COPY_EXISTING ~%b24_res%.spl~ ~override~
      READ_LONG  0x64 b24_hoff
      READ_SHORT 0x68 b24_hnum
      READ_LONG  0x6a b24_foff
      FOR (h = 0; h < b24_hnum; ++h) BEGIN
        READ_SHORT (b24_hoff + h * 0x28 + 0x1e) b24_fnum
        READ_SHORT (b24_hoff + h * 0x28 + 0x20) b24_fidx
        FOR (k = 0; k < b24_fnum; ++k) BEGIN
          WRITE_LONG (b24_foff + (b24_fidx + k) * 0x30 + 0x1c) 0
          WRITE_LONG (b24_foff + (b24_fidx + k) * 0x30 + 0x20) 0
        END
      END
      PATCH_IF (~%b24_res%~ STRING_EQUAL_CASE ~spwi116~) BEGIN
        LPF ALTER_EFFECT INT_VAR match_opcode = 39 duration = 60 END
      END ELSE BEGIN
        LPF ALTER_EFFECT INT_VAR match_opcode = 39 opcode = 74 parameter1 = 0 parameter2 = 0 duration = 6 special = 0 END
        LPF ALTER_EFFECT INT_VAR match_opcode = 7 duration = 6 END
        WRITE_LONG 0x50 RESOLVE_STR_REF (@753)
      END
      BUT_ONLY
  END
END
// Flesh to Stone: restrained first, petrified after three failed saves (B24COND.lua); only the
// description changes here. Greater Restoration ends petrification (op43, as Stone to Flesh).
ACTION_IF FILE_EXISTS_IN_GAME ~spwi604.spl~ BEGIN
  COPY_EXISTING ~spwi604.spl~ ~override~
    WRITE_LONG 0x50 RESOLVE_STR_REF (@754)
    BUT_ONLY
END
// Greater Restoration ends conditions (2024: one reduction or condition) and no longer heals (BG's
// full heal, op17, is gone; 2024's Greater Restoration restores no hit points).
ACTION_IF FILE_EXISTS_IN_GAME ~sppr713.spl~ BEGIN
  COPY_EXISTING ~sppr713.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 43 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 43 target = 2 timing = 1 probability1 = 100 END
    LPF DELETE_EFFECT INT_VAR match_opcode = 17 END
    SAY 0x50 @788
    BUT_ONLY
END
// Haste: one creature within 30 feet, for a minute (concentration, from the catalog): +2 AC, BG's
// haste (double speed, an extra attack), advantage on Dexterity saves (B24SPELL.lua); when it ends
// the creature is stunned for a round (lethargy: at the minute's end here, earlier when
// concentration breaks, B24SPELL.lua). Instead of BG's area haste by caster level with fatigue.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi305.spl~ BEGIN
  COPY_EXISTING ~spwi305.spl~ ~override~
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_BYTE  (b24_hoff + h * 0x28 + 0x0c) 1
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) 30
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x26) 1
    END
    LPF ALTER_EFFECT INT_VAR match_opcode = 16 duration = 60 END
    LPF ALTER_EFFECT INT_VAR match_opcode = 142 duration = 60 END
    LPF ALTER_EFFECT INT_VAR match_opcode = 174 match_timing = 4 duration = 60 END
    LPF ALTER_EFFECT INT_VAR match_opcode = 93 opcode = 402 parameter1 = 0 parameter2 = 0 timing = 4 duration = 60
      STR_VAR resource = ~B24LETHA~ END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 0 target = 2 timing = 0 duration = 60 parameter1 = 2 probability1 = 100 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@755)
    BUT_ONLY
END
// Vampiric Touch: a melee spell attack for 3d6 necrotic damage (BG magic damage), the caster
// regains half of it (B24SATK), instead of BG's draining touch charge.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi314.spl~ BEGIN
  COPY_EXISTING - ~sppr103.spl~ ~override~
    READ_LONG 0x64 b24_hoff
    READ_SHORT (b24_hoff + 0x0e) b24_touch_range
  COPY_EXISTING ~spwi314.spl~ ~override~
    LPF b24_strip_effects END
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_BYTE  (b24_hoff + h * 0x28 + 0x0c) 1
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) b24_touch_range
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24SATK~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@756)
    BUT_ONLY
END
// Vampiric Touch again: the innate the spell grants while its concentration lasts (B24VTAGN in
// B24SPELL.lua): the touch once more each round.
LAF b24_create_innate INT_VAR name = RESOLVE_STR_REF (@789) description = RESOLVE_STR_REF (@790) opcode = 402 touch = 1
  STR_VAR resref = ~B24VTAGN~ icon = ~SPWI314C~ effect_res = ~B24VTAGN~ END
// Bhaalspawn powers (the protagonist's innates from the dreams) in 2024 form: Cure Light Wounds
// heals as Cure Wounds (2d8 + casting ability modifier, B24HEAL) instead of 8; Vampiric Touch is
// the 2024 spell (melee spell attack, 3d6, the caster regains half; B24SATK knows SPIN106) instead
// of BG's drain (SPIN106A). Slow Poison, Draw Upon Holy Might, Larloch's Minor Drain and Horror
// stay as they are (their saves go through the 2024 save rules already).
ACTION_IF FILE_EXISTS_IN_GAME ~spin101.spl~ BEGIN
  COPY_EXISTING ~spin101.spl~ ~override~
    LPF ALTER_EFFECT INT_VAR match_opcode = 17 opcode = 402 parameter1 = 2 parameter2 = 8 STR_VAR resource = ~B24HEAL~ END
    SAY 0x50 @786
    BUT_ONLY
END
ACTION_IF FILE_EXISTS_IN_GAME ~spin106.spl~ BEGIN
  COPY_EXISTING ~spin106.spl~ ~override~
    LPF b24_strip_effects END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100
      parameter1 = 3 parameter2 = 6 STR_VAR resource = ~B24SATK~ END
    SAY 0x50 @787
    BUT_ONLY
END
// Aid: +5 maximum and current hit points for 8 hours for the target and up to two more party
// members near it, +5 per spell level above 2 (B24AID in B24SPELL.lua; the catalog's upcast column
// only makes the level copies), instead of BG's +1 to attacks and saves and a few hit points by
// caster level (op129).
ACTION_IF FILE_EXISTS_IN_GAME ~sppr201.spl~ BEGIN
  COPY_EXISTING ~sppr201.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 129 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24AID~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@757)
    BUT_ONLY
END
// Bane: a Charisma save (from the catalog) against BG's -2 to attacks and saves (the mod's flat
// stand-in for -1d4, as Bless).
ACTION_IF FILE_EXISTS_IN_GAME ~sppr113.spl~ BEGIN
  COPY_EXISTING ~sppr113.spl~ ~override~
    PATCH_FOR_EACH b24_op IN 54 33 34 35 36 37 142 328 BEGIN
      LPF ALTER_EFFECT INT_VAR match_opcode = b24_op savingthrow = 1 END
    END
    LPF ALTER_EFFECT INT_VAR match_opcode = 174 match_timing = 4 savingthrow = 1 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@758)
    BUT_ONLY
END
// Command: no hit dice limit (the fields of BG's sleep), only the creatures that fail the Wisdom
// save are affected (BG's unsaved sleep for weak creatures goes).
ACTION_IF FILE_EXISTS_IN_GAME ~sppr102.spl~ BEGIN
  COPY_EXISTING ~sppr102.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 39 match_savingthrow = 0 END
    LPF DELETE_EFFECT INT_VAR match_opcode = 174 match_savingthrow = 0 match_timing = 4 END
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    READ_LONG  0x6a b24_foff
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      READ_SHORT (b24_hoff + h * 0x28 + 0x1e) b24_fnum
      READ_SHORT (b24_hoff + h * 0x28 + 0x20) b24_fidx
      FOR (k = 0; k < b24_fnum; ++k) BEGIN
        WRITE_LONG (b24_foff + (b24_fidx + k) * 0x30 + 0x1c) 0
        WRITE_LONG (b24_foff + (b24_fidx + k) * 0x30 + 0x20) 0
      END
    END
    BUT_ONLY
END
// Protection from Energy: an hour (concentration) instead of BG's minutes by caster level. It keeps
// BG's resistance to all four energies (2024: one type of the caster's choice).
ACTION_IF FILE_EXISTS_IN_GAME ~sppr210.spl~ BEGIN
  COPY_EXISTING ~sppr210.spl~ ~override~
    PATCH_FOR_EACH b24_op IN 28 30 84 85 142 328 BEGIN
      LPF ALTER_EFFECT INT_VAR match_opcode = b24_op duration = 3600 END
    END
    LPF ALTER_EFFECT INT_VAR match_opcode = 174 match_timing = 4 duration = 3600 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@767)
    BUT_ONLY
END
// Death Ward: 8 hours; the first drop to 0 hit points leaves the creature at 1 instead and ends the
// spell (B24DYING.lua); BG's immunity to death magic stays.
ACTION_IF FILE_EXISTS_IN_GAME ~sppr409.spl~ BEGIN
  COPY_EXISTING ~sppr409.spl~ ~override~
    PATCH_FOR_EACH b24_op IN 101 169 142 328 282 BEGIN
      LPF ALTER_EFFECT INT_VAR match_opcode = b24_op duration = 28800 END
    END
    LPF ALTER_EFFECT INT_VAR match_opcode = 174 match_timing = 4 duration = 28800 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@759)
    BUT_ONLY
END
// Ice Storm: 2d10 bludgeoning (BG crushing) and 4d6 cold damage, Dexterity save for half, once
// per creature (B24AREA in B24SPELL.lua), instead of BG's unsaved 2d8 cold every round for 4 rounds.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi404.spl~ BEGIN
  COPY_EXISTING ~spwi404.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 12 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24AREA~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@760)
    BUT_ONLY
END
// Stoneskin: resistance to bludgeoning, piercing and slashing damage (and BG's missile damage) for
// an hour (concentration), on a creature touched, instead of BG's skins that absorb whole hits.
ACTION_FOR_EACH b24_res IN ~spwi408~ ~sppr506~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_res%.spl~ BEGIN
    COPY_EXISTING - ~sppr103.spl~ ~override~
      READ_LONG 0x64 b24_hoff
      READ_SHORT (b24_hoff + 0x0e) b24_touch_range
    COPY_EXISTING ~%b24_res%.spl~ ~override~
      LPF DELETE_EFFECT INT_VAR match_opcode = 218 END
      READ_LONG  0x64 b24_hoff
      READ_SHORT 0x68 b24_hnum
      FOR (h = 0; h < b24_hnum; ++h) BEGIN
        WRITE_BYTE  (b24_hoff + h * 0x28 + 0x0c) 1
        WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) b24_touch_range
      END
      LPF ALTER_EFFECT INT_VAR target = 2 END
      PATCH_FOR_EACH b24_op IN 86 87 88 89 BEGIN
        LPF ADD_SPELL_EFFECT INT_VAR opcode = b24_op target = 2 timing = 0 duration = 3600 parameter1 = 50 probability1 = 100 END
      END
      WRITE_LONG 0x50 RESOLVE_STR_REF (@761)
      BUT_ONLY
  END
END
// Cloudkill: 5d8 poison damage each round in the cloud, Constitution save for half (dice and save
// from the catalog), instead of BG's instant death for weak creatures and 1d10 unsaved.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi502.spl~ BEGIN
  COPY_EXISTING ~spwi502.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 55 END
    LPF ALTER_EFFECT INT_VAR match_opcode = 12 savingthrow = 0x1000001 special = 256 END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@762)
    BUT_ONLY
END
// Incendiary Cloud: 10d8 fire damage, Dexterity save for half (dice from the catalog); only the
