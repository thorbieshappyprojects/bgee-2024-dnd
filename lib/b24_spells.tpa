    LPF DELETE_EFFECT INT_VAR match_opcode = 12 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24AREA~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@764)
