  COPY_EXISTING ~spwi715.spl~ ~override~
    PATCH_FOR_EACH b24_op IN 210 324 BEGIN
      LPF DELETE_EFFECT INT_VAR match_opcode = b24_op END
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24PWS~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@766)
    BUT_ONLY
END
// Tenser's Transformation: advantage on attacks (B24SPELL.lua) instead of BG's +9 attack bonus
// and +4 AC; the extra hit points and the damage bonus stay.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi603.spl~ BEGIN
  COPY_EXISTING ~spwi603.spl~ ~override~
    LPF DELETE_EFFECT INT_VAR match_opcode = 54 END
    LPF DELETE_EFFECT INT_VAR match_opcode = 0 END
    BUT_ONLY
END

// Spell levels by file name. BG files a spell under the level digit of its name (SPWI3xx = level
// 3) in character creation, level-up picks, the priest spell lists and the spellbook, and only
// lists priest spells named SPPR<level><nn>. Spells in $b24_relocate (resref => 2024 level) get a
// copy under such a name (ADD_SPELL takes the first free one and adds a SPELL.IDS entry); the
// table rows of the old name are copied to the new one. Re-leveled originals are hidden.
// $b24_moved_to(old) = new; B24MOVED.2DA (written at the end) lets B24SPELL.lua swap them in
// existing spellbooks, and scrolls teach the new name.
OUTER_TEXT_SPRINT b24_moved_rows ~~
DEFINE_ACTION_MACRO b24_relocate_spells BEGIN
  ACTION_PHP_EACH b24_relocate AS b24_old => b24_lvl BEGIN
    ACTION_IF (NOT VARIABLE_IS_SET $b24_moved_to(~%b24_old%~)) AND (FILE_EXISTS_IN_GAME ~%b24_old%.spl~) BEGIN
      COPY_EXISTING ~%b24_old%.spl~ ~override~
        READ_SHORT 0x1c b24_spl_type
        WRITE_LONG 0x34 b24_lvl
        BUT_ONLY
      OUTER_SET b24_add_type = (b24_spl_type == 2) ? 1 : 2      // ADD_SPELL: 1 priest, 2 wizard
      OUTER_TEXT_SPRINT b24_ids ~B24_%b24_old%~
      ADD_SPELL ~override/%b24_old%.spl~ b24_add_type b24_lvl ~%b24_ids%~
      OUTER_SET b24_code = IDS_OF_SYMBOL (~spell~ ~%b24_ids%~)
      OUTER_SET b24_nn = b24_code - (b24_code / 100) * 100
      OUTER_TEXT_SPRINT b24_prefix ~SPWI~
      ACTION_IF (b24_add_type == 1) BEGIN OUTER_TEXT_SPRINT b24_prefix ~SPPR~ END
      OUTER_TEXT_SPRINT b24_new ~%b24_prefix%%b24_lvl%%b24_nn%~
      ACTION_IF (b24_nn < 10) BEGIN OUTER_TEXT_SPRINT b24_new ~%b24_prefix%%b24_lvl%0%b24_nn%~ END
      OUTER_TEXT_SPRINT $b24_moved_to(~%b24_old%~) ~%b24_new%~
      OUTER_TEXT_SPRINT b24_moved_rows ~%b24_moved_rows%%b24_old%  %b24_new%%LNL%~
      // Re-leveled originals (not the 8-letter upcast versions, which no list shows anyway).
      ACTION_IF (STRING_LENGTH ~%b24_old%~ == 7) AND (~%b24_old%~ STRING_MATCHES_REGEXP ~^SP\(WI\|PR\).*~ = 0) BEGIN
        APPEND ~hidespl.2da~ ~%b24_old%  1  0  0~
      END
      // Concentration, save and upcast rows follow the spell.
      ACTION_FOR_EACH b24_table IN ~b24conc.2da~ ~b24saves.2da~ BEGIN
        COPY_EXISTING ~%b24_table%~ ~override~
          REPLACE_TEXTUALLY ~^%b24_old%\( [^%LNL%%WNL%]*\)~ ~%b24_old%\1%LNL%%b24_new%\1~
          BUT_ONLY
      END
      COPY_EXISTING ~b24upcst.2da~ ~override~
        REPLACE_TEXTUALLY ~ %b24_old% ~ ~ %b24_new% ~
        BUT_ONLY
    END
  END
END

ACTION_DEFINE_ASSOCIATIVE_ARRAY b24_ability_name BEGIN
  STR => Strength  DEX => Dexterity  CON => Constitution  INT => Intelligence  WIS => Wisdom  CHA => Charisma
END

// Spell ranges (the catalog's RANGE): touch as Cure Wounds has it; the longest 2024 ranges (Meteor
// Swarm's mile) stop at b24_range_cap.
COPY_EXISTING ~sppr103.spl~ ~override~
  READ_LONG  0x64 b24_hoff
  READ_SHORT (b24_hoff + 0x0e) b24_touch_units
  BUT_ONLY
OUTER_SET b24_range_cap = 300

COPY - ~bg2024/tables/b24spell.2da~ ~override~
  READ_2DA_ENTRIES_NOW b24_spells 10
  FOR (r = 0; r < b24_spells; ++r) BEGIN
  READ_2DA_ENTRY_FORMER b24_spells r 0 b24_res
  READ_2DA_ENTRY_FORMER b24_spells r 1 b24_action
  READ_2DA_ENTRY_FORMER b24_spells r 2 b24_level
  READ_2DA_ENTRY_FORMER b24_spells r 3 b24_lists
  READ_2DA_ENTRY_FORMER b24_spells r 4 b24_conc
  READ_2DA_ENTRY_FORMER b24_spells r 5 b24_save
  READ_2DA_ENTRY_FORMER b24_spells r 6 b24_dice
  READ_2DA_ENTRY_FORMER b24_spells r 7 b24_upcast
  READ_2DA_ENTRY_FORMER b24_spells r 8 b24_range
  READ_2DA_ENTRY_FORMER b24_spells r 9 b24_name
  TEXT_SPRINT $b24_catalog_action(~%b24_res%~) ~%b24_action%~
  TEXT_SPRINT $b24_catalog_level(~%b24_res%~) ~%b24_level%~
  TEXT_SPRINT $b24_catalog_lists(~%b24_res%~) ~%b24_lists%~
  TEXT_SPRINT $b24_catalog_conc(~%b24_res%~) ~%b24_conc%~
  TEXT_SPRINT $b24_catalog_save(~%b24_res%~) ~%b24_save%~
  TEXT_SPRINT $b24_catalog_dice(~%b24_res%~) ~%b24_dice%~
  TEXT_SPRINT $b24_catalog_upcast(~%b24_res%~) ~%b24_upcast%~
  TEXT_SPRINT $b24_catalog_range(~%b24_res%~) ~%b24_range%~
  TEXT_SPRINT $b24_catalog_name(~%b24_res%~) ~%b24_name%~
END

// Dimension Door and Storm of Vengeance: BG hides them from the spell lists (High Level Ability
// versions; the mod has no HLAs, b24_core_runtime.tpa), the 2024 lists have them.
COPY_EXISTING ~hidespl.2da~ ~override~
  REPLACE_TEXTUALLY CASE_INSENSITIVE ~^\(SPWI402\|SPPR722\)[ %TAB%][^%LNL%%WNL%]*[%LNL%%WNL%]+~ ~~
  BUT_ONLY

ACTION_PHP_EACH b24_catalog_action AS b24_res => b24_action BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_res%.spl~ BEGIN
    OUTER_TEXT_SPRINT b24_level  $b24_catalog_level(~%b24_res%~)
    OUTER_TEXT_SPRINT b24_lists  $b24_catalog_lists(~%b24_res%~)
    OUTER_TEXT_SPRINT b24_conc   $b24_catalog_conc(~%b24_res%~)
    OUTER_TEXT_SPRINT b24_save   $b24_catalog_save(~%b24_res%~)
    OUTER_TEXT_SPRINT b24_dice   $b24_catalog_dice(~%b24_res%~)
    OUTER_TEXT_SPRINT b24_upcast $b24_catalog_upcast(~%b24_res%~)
    OUTER_TEXT_SPRINT b24_range  $b24_catalog_range(~%b24_res%~)
    OUTER_TEXT_SPRINT b24_name   $b24_catalog_name(~%b24_res%~)
    ACTION_IF (~%b24_action%~ STRING_EQUAL ~DROP~) BEGIN
      APPEND ~hidespl.2da~ ~%b24_res%  1  0  0~
      OUTER_SET $b24_dropped(~%b24_res%~) = 1
    END ELSE BEGIN
      OUTER_PATCH_SAVE b24_display ~%b24_name%~ BEGIN REPLACE_TEXTUALLY ~_~ ~ ~ END
      OUTER_SET b24_is_priest = 0
      COPY_EXISTING ~%b24_res%.spl~ ~override~
        WRITE_LONG 0x34 b24_level
        READ_SHORT 0x1c b24_type
        PATCH_IF (b24_type == 2) BEGIN
          SET b24_is_priest = 1
          LPF b24_priest_lists STR_VAR lists = EVAL ~%b24_lists%~ END
        END
        PATCH_IF (NOT (~%b24_name%~ STRING_EQUAL ~-~)) BEGIN
          SAY_EVALUATED 0x08 ~%b24_display%~
        END
        // 2024 casting time: an action (or a reaction) for almost every spell, so the spell
        // goes off within the round; spells with long 2024 casting times keep theirs.
        PATCH_IF NOT VARIABLE_IS_SET $b24_slow_cast(~%b24_res%~) BEGIN
          READ_LONG  0x64 b24_hoff
          READ_SHORT 0x68 b24_hnum
          FOR (h = 0; h < b24_hnum; ++h) BEGIN
            WRITE_SHORT (b24_hoff + h * 0x28 + 0x12) 1
          END
          READ_LONG 0x50 b24_desc_ref
          PATCH_IF (b24_desc_ref > 0) BEGIN
            READ_STRREF 0x50 b24_desc
            INNER_PATCH_SAVE b24_new_desc ~%b24_desc%~ BEGIN
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~Casting Time: *[^%LNL%%WNL%]*~ ~Casting Time: 1 action~
            END
            PATCH_IF NOT (~%b24_new_desc%~ STRING_EQUAL ~%b24_desc%~) BEGIN
              SAY_EVALUATED 0x50 ~%b24_new_desc%~
            END
          END
        END
        // The 2024 save in the description: "Saving Throw: Neg." becomes "Saving Throw: Dexterity
        // (negates)", and the ability saves the core texts derived from the 2e categories become
        // the spell's own (as the save screen rolls it, B24SAVES.2DA).
        PATCH_IF NOT (~%b24_save%~ STRING_EQUAL ~-~) BEGIN
          TEXT_SPRINT b24_save_name $b24_ability_name(~%b24_save%~)
          READ_LONG 0x50 b24_desc_ref
          PATCH_IF (b24_desc_ref > 0) BEGIN
            READ_STRREF 0x50 b24_desc
            INNER_PATCH_SAVE b24_new_desc ~%b24_desc%~ BEGIN
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~Saving Throw: *Neg\.?~ ~Saving Throw: %b24_save_name% (negates)~
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~Saving Throw: *1/2~ ~Saving Throw: %b24_save_name% (half)~
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~Saving Throw: *Special~ ~Saving Throw: %b24_save_name% (special)~
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~Saving Throw: *None~ ~Saving Throw: %b24_save_name%~
              REPLACE_TEXTUALLY ~\(Strength\|Dexterity\|Constitution\|Intelligence\|Wisdom\|Charisma\) save~ ~%b24_save_name% save~
            END
            PATCH_IF NOT (~%b24_new_desc%~ STRING_EQUAL ~%b24_desc%~) BEGIN
              SAY_EVALUATED 0x50 ~%b24_new_desc%~
            END
          END
        END
        // The 2024 range (RANGE: feet, T touch, "-" keeps BG's) on the headers that target a
        // creature or a point; a BG range unit is a foot (6.4 world units, measured with -Mode RangeProbe),
        // up to b24_range_cap.
        PATCH_IF (NOT (~%b24_range%~ STRING_EQUAL ~-~)) BEGIN
          PATCH_IF (~%b24_range%~ STRING_EQUAL ~T~) BEGIN
            SET b24_units = b24_touch_units
            TEXT_SPRINT b24_range_text ~Touch~
          END ELSE BEGIN
            SET b24_units = b24_range
            PATCH_IF (b24_units > b24_range_cap) BEGIN SET b24_units = b24_range_cap END
            TEXT_SPRINT b24_range_text ~%b24_range% feet~
            PATCH_IF (b24_range = 5280) BEGIN TEXT_SPRINT b24_range_text ~1 mile~ END
          END
          READ_LONG  0x64 b24_hoff
          READ_SHORT 0x68 b24_hnum
          FOR (h = 0; h < b24_hnum; ++h) BEGIN
            READ_BYTE (b24_hoff + h * 0x28 + 0x0c) b24_target
            PATCH_IF ((b24_target != 5) AND (b24_target != 7)) BEGIN
              WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) b24_units
            END
          END
          READ_LONG 0x50 b24_desc_ref
          PATCH_IF (b24_desc_ref > 0) BEGIN
            READ_STRREF 0x50 b24_desc
            INNER_PATCH_SAVE b24_new_desc ~%b24_desc%~ BEGIN
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~Range: *[^%LNL%%WNL%]*~ ~Range: %b24_range_text%~
            END
            PATCH_IF NOT (~%b24_new_desc%~ STRING_EQUAL ~%b24_desc%~) BEGIN
              SAY_EVALUATED 0x50 ~%b24_new_desc%~
            END
          END
        END
        PATCH_IF (NOT (~%b24_dice%~ STRING_EQUAL ~-~)) BEGIN
          LPF b24_parse_dice STR_VAR text = EVAL ~%b24_dice%~ RET b24_n = dice_n b24_s = dice_s b24_flat = flat b24_heal = heal END
          LPF b24_spell_numbers INT_VAR dice_n = b24_n dice_s = b24_s flat = b24_flat heal = b24_heal END
        END
        BUT_ONLY
      ACTION_IF (~%b24_conc%~ STRING_EQUAL ~1~) BEGIN
        APPEND ~b24conc.2da~ ~%b24_res%  %b24_name%~
      END
      ACTION_IF NOT (~%b24_save%~ STRING_EQUAL ~-~) BEGIN
        APPEND ~b24saves.2da~ ~%b24_res%  %b24_save%  %b24_name%~
      END
      // A 2024 level that differs from the file name's level digit: filed again further down.
      OUTER_PATCH_SAVE b24_digit ~%b24_res%~ BEGIN REPLACE_TEXTUALLY ~^SP\(WI\|PR\)\([0-9]\).*$~ ~\2~ END
      ACTION_IF (IS_AN_INT b24_digit) BEGIN
        ACTION_IF (b24_digit != b24_level) BEGIN
          OUTER_SET $b24_relocate(~%b24_res%~) = b24_level
        END
      END

      // Upcast versions (upcasting option A): a copy per higher spell level, e.g. SPWI3045 is
      // Fireball cast with a 5th level slot. Arcane versions are hidden from spell selection and
      // learned automatically with the base spell (B24SPELL.lua); priest versions are filed under
      // a priest spell name of their level (below), so priests find them in their lists.
      ACTION_IF NOT (~%b24_upcast%~ STRING_EQUAL ~-~) BEGIN
        OUTER_SET b24_max = b24_is_priest ? 7 : 9
        OUTER_PATCH_SAVE b24_up_text ~%b24_upcast%~ BEGIN REPLACE_TEXTUALLY ~^H~ ~~ END
        COPY - ~bg2024/tables/b24spell.2da~ ~override~
          LPF b24_parse_dice STR_VAR text = EVAL ~%b24_dice%~ RET b24_n = dice_n b24_s = dice_s b24_flat = flat b24_heal = heal END
          LPF b24_parse_dice STR_VAR text = EVAL ~%b24_upcast%~ RET b24_un = dice_n b24_us = dice_s b24_uflat = flat b24_uheal = heal END
        OUTER_FOR (b24_up = b24_level + 1; b24_up <= b24_max; ++b24_up) BEGIN
          OUTER_SET b24_steps = b24_up - b24_level
          COPY_EXISTING ~%b24_res%.spl~ ~override/%b24_res%%b24_up%.spl~
            WRITE_LONG 0x34 b24_up
            SAY_EVALUATED 0x08 ~%b24_display% (level %b24_up%)~
            LPF b24_spell_numbers INT_VAR dice_n = (b24_n + b24_steps * b24_un) dice_s = b24_s
              flat = (b24_flat + b24_steps * b24_uflat) heal = b24_heal END
          ACTION_IF (~%b24_conc%~ STRING_EQUAL ~1~) BEGIN
            APPEND ~b24conc.2da~ ~%b24_res%%b24_up%  %b24_name%~
          END
          ACTION_IF NOT (~%b24_save%~ STRING_EQUAL ~-~) BEGIN
            APPEND ~b24saves.2da~ ~%b24_res%%b24_up%  %b24_save%  %b24_name%~
          END
          ACTION_IF NOT b24_is_priest BEGIN
            APPEND ~hidespl.2da~ ~%b24_res%%b24_up%  1  0  0~
            APPEND ~b24upcst.2da~ ~%b24_res%%b24_up%  %b24_res%  %b24_up%~
          END ELSE BEGIN
            // Priest versions go into the priest lists under a name with their level.
            OUTER_SET $b24_relocate(~%b24_res%%b24_up%~) = b24_up
          END
        END
      END
    END
  END
END

LAM b24_relocate_spells

// Scrolls of dropped spells can still be read, but no longer teach the spell; scrolls of re-filed
// spells teach the new name.
COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
  PATCH_IF (SOURCE_SIZE > 0x71) BEGIN
    READ_SHORT 0x1c b24_itype
    PATCH_IF (b24_itype == 11) BEGIN
      READ_LONG  0x64 hdr_off
      READ_SHORT 0x68 hdr_num
      READ_LONG  0x6a fx_off
      FOR (h = 0; h < hdr_num; ++h) BEGIN
        READ_SHORT (hdr_off + h * 0x38 + 0x1e) fx_num
        READ_SHORT (hdr_off + h * 0x38 + 0x20) fx_idx
        FOR (k = 0; k < fx_num; ++k) BEGIN
          SET f = fx_off + (fx_idx + k) * 0x30
          READ_SHORT f opcode
          PATCH_IF (opcode == 147) BEGIN
            READ_ASCII (f + 0x14) b24_learn (8) NULL
            TO_UPPER b24_learn
            PATCH_IF VARIABLE_IS_SET $b24_dropped(~%b24_learn%~) BEGIN
              WRITE_SHORT f 0      // AC bonus +0: harmless, keeps the effect count unchanged
              WRITE_LONG (f + 0x04) 0
              WRITE_LONG (f + 0x08) 0
            END ELSE PATCH_IF VARIABLE_IS_SET $b24_moved_to(~%b24_learn%~) BEGIN
              // Re-filed spells: the scroll teaches the new name.
              TEXT_SPRINT b24_learn_new $b24_moved_to(~%b24_learn%~)
              WRITE_ASCIIE (f + 0x14) ~%b24_learn_new%~ #8
            END
          END
        END
      END
    END
  END
  BUT_ONLY

// Cantrips (innate, at will; B24CANT in B24SPELL.lua, parameter 1 = index in B24SP.CANTRIPS).
// Range 0 = around the caster (Word of Radiance).
DEFINE_ACTION_MACRO b24_cantrip
BEGIN
  LAF b24_create_lua_spell
    INT_VAR name = b24_name description = b24_desc type = 4 level = 1 target = (b24_range == 0) ? 5 : 1
            range = b24_range cast_anim = b24_anim parameter1 = b24_id
    STR_VAR resref = EVAL ~%b24_res%~ icon = EVAL ~%b24_icon%~ function = ~B24CANT~
  END
END
OUTER_SET b24_id = 1  OUTER_SPRINT b24_res B24CACID OUTER_SPRINT b24_icon SPWI313C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 5
OUTER_SET b24_name = RESOLVE_STR_REF (@300) OUTER_SET b24_desc = RESOLVE_STR_REF (@301) LAM b24_cantrip
OUTER_SET b24_id = 2  OUTER_SPRINT b24_res B24CCHIL OUTER_SPRINT b24_icon SPWI117C OUTER_SET b24_range = 1 OUTER_SET b24_anim = 9
OUTER_SET b24_name = RESOLVE_STR_REF (@302) OUTER_SET b24_desc = RESOLVE_STR_REF (@303) LAM b24_cantrip
OUTER_SET b24_id = 3  OUTER_SPRINT b24_res B24CFIRE OUTER_SPRINT b24_icon SPPR106C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 15
OUTER_SET b24_name = RESOLVE_STR_REF (@304) OUTER_SET b24_desc = RESOLVE_STR_REF (@305) LAM b24_cantrip
OUTER_SET b24_id = 4  OUTER_SPRINT b24_res B24CPOIS OUTER_SPRINT b24_icon SPWI213C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 11
OUTER_SET b24_name = RESOLVE_STR_REF (@306) OUTER_SET b24_desc = RESOLVE_STR_REF (@307) LAM b24_cantrip
OUTER_SET b24_id = 5  OUTER_SPRINT b24_res B24CFROS OUTER_SPRINT b24_icon SPWI320C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 15
OUTER_SET b24_name = RESOLVE_STR_REF (@308) OUTER_SET b24_desc = RESOLVE_STR_REF (@309) LAM b24_cantrip
OUTER_SET b24_id = 6  OUTER_SPRINT b24_res B24CSHOC OUTER_SPRINT b24_icon SPWI115C OUTER_SET b24_range = 1 OUTER_SET b24_anim = 10
OUTER_SET b24_name = RESOLVE_STR_REF (@310) OUTER_SET b24_desc = RESOLVE_STR_REF (@311) LAM b24_cantrip
OUTER_SET b24_id = 7  OUTER_SPRINT b24_res B24CBURS OUTER_SPRINT b24_icon SPWI112C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 15
OUTER_SET b24_name = RESOLVE_STR_REF (@312) OUTER_SET b24_desc = RESOLVE_STR_REF (@313) LAM b24_cantrip
OUTER_SET b24_id = 8  OUTER_SPRINT b24_res B24CSACR OUTER_SPRINT b24_icon SPPR450C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 9
OUTER_SET b24_name = RESOLVE_STR_REF (@314) OUTER_SET b24_desc = RESOLVE_STR_REF (@315) LAM b24_cantrip
OUTER_SET b24_id = 9  OUTER_SPRINT b24_res B24CTOLL OUTER_SPRINT b24_icon SPWI119C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 11
OUTER_SET b24_name = RESOLVE_STR_REF (@316) OUTER_SET b24_desc = RESOLVE_STR_REF (@317) LAM b24_cantrip
OUTER_SET b24_id = 10 OUTER_SPRINT b24_res B24CWORD OUTER_SPRINT b24_icon SPCL236C OUTER_SET b24_range = 0 OUTER_SET b24_anim = 9
OUTER_SET b24_name = RESOLVE_STR_REF (@318) OUTER_SET b24_desc = RESOLVE_STR_REF (@319) LAM b24_cantrip
OUTER_SET b24_id = 11 OUTER_SPRINT b24_res B24CFLAM OUTER_SPRINT b24_icon SPPR503C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 9
OUTER_SET b24_name = RESOLVE_STR_REF (@320) OUTER_SET b24_desc = RESOLVE_STR_REF (@321) LAM b24_cantrip
OUTER_SET b24_id = 12 OUTER_SPRINT b24_res B24CTHRN OUTER_SPRINT b24_icon SPPR105C OUTER_SET b24_range = 20 OUTER_SET b24_anim = 9
OUTER_SET b24_name = RESOLVE_STR_REF (@322) OUTER_SET b24_desc = RESOLVE_STR_REF (@323) LAM b24_cantrip
OUTER_SET b24_id = 13 OUTER_SPRINT b24_res B24CWISP OUTER_SPRINT b24_icon SPPR751C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 9
OUTER_SET b24_name = RESOLVE_STR_REF (@324) OUTER_SET b24_desc = RESOLVE_STR_REF (@325) LAM b24_cantrip
OUTER_SET b24_id = 14 OUTER_SPRINT b24_res B24CMOCK OUTER_SPRINT b24_icon SPWI411C OUTER_SET b24_range = 60 OUTER_SET b24_anim = 11
OUTER_SET b24_name = RESOLVE_STR_REF (@326) OUTER_SET b24_desc = RESOLVE_STR_REF (@327) LAM b24_cantrip

// New 2024 spells. Healing uses B24HEAL (parameter 1 dice, parameter 2 die size); the bard
// versions are arcane copies only bards keep (B24SPELL.lua); the others call B24NSPL with their
// index in B24SP.SPELLS.
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@340) description = RESOLVE_STR_REF (@341) type = 2 level = 1 range = 60
  cast_anim = 9 parameter1 = 2 parameter2 = 4 STR_VAR resref = ~B24HWORD~ icon = ~SPPR401C~ function = ~B24HEAL~ lists = ~CD~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@340) description = RESOLVE_STR_REF (@341) type = 1 level = 1 range = 60
  cast_anim = 9 parameter1 = 2 parameter2 = 4 STR_VAR resref = ~B24HWBRD~ icon = ~SPPR401C~ function = ~B24HEAL~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@342) description = RESOLVE_STR_REF (@343) type = 1 level = 1 range = 1
  cast_anim = 9 parameter1 = 2 parameter2 = 8 STR_VAR resref = ~B24CWBRD~ icon = ~SPPR103B~ function = ~B24HEAL~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@346) description = RESOLVE_STR_REF (@347) type = 2 level = 1 range = 60
  cast_anim = 9 parameter1 = 1 STR_VAR resref = ~B24GBOLT~ icon = ~SPPR614C~ function = ~B24NSPL~ lists = ~C~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@348) description = RESOLVE_STR_REF (@349) type = 1 level = 1 target = 5
  cast_anim = 11 parameter1 = 2 STR_VAR resref = ~B24THWAV~ icon = ~SPWI621C~ function = ~B24NSPL~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@348) description = RESOLVE_STR_REF (@349) type = 2 level = 1 target = 5
  cast_anim = 11 parameter1 = 2 STR_VAR resref = ~B24THWVD~ icon = ~SPWI621C~ function = ~B24NSPL~ lists = ~D~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@350) description = RESOLVE_STR_REF (@351) type = 1 level = 2 range = 60
  cast_anim = 11 parameter1 = 3 STR_VAR resref = ~B24SHATR~ icon = ~SPWI913C~ function = ~B24NSPL~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@354) description = RESOLVE_STR_REF (@355) type = 2 level = 3 target = 5
  cast_anim = 9 parameter1 = 4 STR_VAR resref = ~B24SPGRD~ icon = ~SPPR150C~ function = ~B24NSPL~ lists = ~C~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@344) description = RESOLVE_STR_REF (@345) type = 2 level = 3 target = 5
  cast_anim = 9 parameter1 = 2 parameter2 = 4 STR_VAR resref = ~B24MHWRD~ icon = ~SPPR514C~ function = ~B24MHEAL~ lists = ~C~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@344) description = RESOLVE_STR_REF (@345) type = 1 level = 3 target = 5
  cast_anim = 9 parameter1 = 2 parameter2 = 4 STR_VAR resref = ~B24MHWBD~ icon = ~SPPR514C~ function = ~B24MHEAL~ END
// Enlarge/Reduce: two spells for the two choices (B24SIZE in B24SPELL.lua, parameter 1: 1 Enlarge, 2
// Reduce), arcane and druid versions.
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@772) description = RESOLVE_STR_REF (@773) type = 1 level = 2 range = 30
  cast_anim = 11 parameter1 = 1 STR_VAR resref = ~B24ENLRG~ icon = ~SPWI214C~ function = ~B24SIZE~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@774) description = RESOLVE_STR_REF (@775) type = 1 level = 2 range = 30
  cast_anim = 11 parameter1 = 2 STR_VAR resref = ~B24REDUC~ icon = ~SPWI221C~ function = ~B24SIZE~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@772) description = RESOLVE_STR_REF (@773) type = 2 level = 2 range = 30
  cast_anim = 11 parameter1 = 1 STR_VAR resref = ~B24ENLDR~ icon = ~SPWI214C~ function = ~B24SIZE~ lists = ~D~ END
LAF b24_create_lua_spell INT_VAR name = RESOLVE_STR_REF (@774) description = RESOLVE_STR_REF (@775) type = 2 level = 2 range = 30
  cast_anim = 11 parameter1 = 2 STR_VAR resref = ~B24REDDR~ icon = ~SPWI221C~ function = ~B24SIZE~ lists = ~D~ END

// Looks borrowed from vanilla spells until the mod has its own (docs/Asset list.md): casting
// sound, hit effects and, where the value is 1, the projectile (single-target models only).
ACTION_DEFINE_ASSOCIATIVE_ARRAY b24_looks BEGIN
  B24CACID, SPWI211 => 1  // Acid Splash: Acid Arrow
  B24CCHIL, SPWI117 => 0  // Chill Touch: Chill Touch (touch)
  B24CFIRE, SPWI303 => 1  // Fire Bolt: Flame Arrow
  B24CPOIS, SPWI119 => 1  // Poison Spray: Larloch's Minor Drain
  B24CFROS, SPWI118 => 1  // Ray of Frost: Chromatic Orb
  B24CSHOC, SPWI115 => 0  // Shocking Grasp: Shocking Grasp (touch)
  B24CBURS, SPWI112 => 1  // Sorcerous Burst: Magic Missile
  B24CSACR, SPPR503 => 0  // Sacred Flame: Flame Strike's flames
  B24CTOLL, SPWI913 => 0  // Toll the Dead: Wail of the Banshee's sound
  B24CWORD, SPPR108 => 0  // Word of Radiance: Remove Fear's burst
  B24CFLAM, SPWI217 => 1  // Produce Flame: Scorching Ray
  B24CTHRN, SPPR105 => 0  // Thorn Whip: Entangle's sounds
  B24CWISP, SPPR106 => 1  // Starry Wisp: Magical Stone
  B24CMOCK, SPWI411 => 0  // Vicious Mockery: Hopelessness
  B24HWORD, SPPR401 => 0  // Healing Word: healing sparkle
  B24HWBRD, SPPR401 => 0
  B24CWBRD, SPPR103 => 0  // Cure Wounds (bard)
  B24GBOLT, SPWI118 => 1  // Guiding Bolt: Chromatic Orb
  B24THWAV, SPWI621 => 0  // Thunderwave: air elemental burst
  B24THWVD, SPWI621 => 0
  B24SHATR, SPWI913 => 0  // Shatter: Wail of the Banshee's sound
  B24SPGRD, SPPR150 => 0  // Spirit Guardians: Spirit Ward
  B24MHWRD, SPPR514 => 0  // Mass Healing Word: Mass Cure Wounds' sparkle
  B24MHWBD, SPPR514 => 0
END
ACTION_PHP_EACH b24_looks AS spell => projectile BEGIN
  LAF b24_spell_look INT_VAR projectile STR_VAR resref = EVAL ~%spell_0%~ model = EVAL ~%spell_1%~ END
END

// Misty Step: Dimension Door at level 2. Revivify: Raise Dead at level 3.
COPY_EXISTING ~spwi402.spl~ ~override/B24MSTEP.spl~
  WRITE_LONG 0x08 RESOLVE_STR_REF (@352)
  WRITE_LONG 0x50 RESOLVE_STR_REF (@353)
  WRITE_LONG 0x34 2
  // 30 feet (Dimension Door's own range is set by the catalog before this copy).
  READ_LONG  0x64 b24_hoff
  READ_SHORT 0x68 b24_hnum
  FOR (h = 0; h < b24_hnum; ++h) BEGIN
    WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) 30
  END
// Revivify's effects are Lua (B24REVIV in B24DYING.lua): only within a minute of death, and it
// also brings back a protagonist past its third failed death save. Cleric and druid lists, so
// paladins and rangers have it too.
COPY_EXISTING ~sppr504.spl~ ~override/B24REVIV.spl~
  WRITE_LONG 0x08 RESOLVE_STR_REF (@356)
  WRITE_LONG 0x50 RESOLVE_STR_REF (@357)
  WRITE_LONG 0x34 3
  LPF b24_priest_lists STR_VAR lists = ~CD~ END
  READ_LONG  0x64 hdr_off
  READ_SHORT 0x68 hdr_num
  READ_LONG  0x6a fx_off
  FOR (h = 0; h < hdr_num; ++h) BEGIN
    READ_SHORT (hdr_off + h * 0x28 + 0x1e) fx_num
    READ_SHORT (hdr_off + h * 0x28 + 0x20) fx_idx
    FOR (k = 0; k < fx_num; ++k) BEGIN
      WRITE_SHORT (fx_off + (fx_idx + k) * 0x30) 999
    END
  END
  LPF DELETE_EFFECT INT_VAR match_opcode = 999 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24REVIV~ END

// New arcane spells are learned automatically by the classes whose lists hold them
// (B24SPELL.lua, B24SP.NEW_ARCANE).

COPY ~bg2024/lua/M_B24SP.lua~   ~override~
     ~bg2024/lua/B24SPELL.lua~  ~override~

// Upcasting of the mod's new spells (as the catalog's upcast versions): a copy per higher slot
// level, B24U + three letters + level (the 8-letter names leave no room for a digit). Spells whose
// dice are in Lua (B24NSPL) read the copy's level (B24SP.UpcastDice); the heals get their dice
// here (heal_up dice per level). Arcane copies are hidden and learned with the base spell
// (B24UPCST.2DA); priest copies go into the priest lists like the base spells (b24_relocate).
// Entries: base, short name, base level, priest (1) or arcane (0), heal dice per level, concentration.
ACTION_FOR_EACH b24_upnew IN
  ~B24GBOLT:GBL:1:1:0:0~ ~B24THWAV:THW:1:0:0:0~ ~B24THWVD:THD:1:1:0:0~ ~B24SHATR:SHA:2:0:0:0~
  ~B24SPGRD:SPG:3:1:0:1~ ~B24HWORD:HWO:1:1:2:0~ ~B24HWBRD:HWB:1:0:2:0~ ~B24MHWRD:MHW:3:1:1:0~
  ~B24MHWBD:MHB:3:0:1:0~ BEGIN
  OUTER_PATCH_SAVE b24_un_base  ~%b24_upnew%~ BEGIN REPLACE_TEXTUALLY ~^\([^:]*\):.*~ ~\1~ END
  OUTER_PATCH_SAVE b24_un_short ~%b24_upnew%~ BEGIN REPLACE_TEXTUALLY ~^[^:]*:\([^:]*\):.*~ ~\1~ END
  OUTER_PATCH_SAVE b24_un_level ~%b24_upnew%~ BEGIN REPLACE_TEXTUALLY ~^[^:]*:[^:]*:\([^:]*\):.*~ ~\1~ END
  OUTER_PATCH_SAVE b24_un_priest ~%b24_upnew%~ BEGIN REPLACE_TEXTUALLY ~^[^:]*:[^:]*:[^:]*:\([^:]*\):.*~ ~\1~ END
  OUTER_PATCH_SAVE b24_un_heal ~%b24_upnew%~ BEGIN REPLACE_TEXTUALLY ~^[^:]*:[^:]*:[^:]*:[^:]*:\([^:]*\):.*~ ~\1~ END
  OUTER_PATCH_SAVE b24_un_conc ~%b24_upnew%~ BEGIN REPLACE_TEXTUALLY ~.*:~ ~~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_un_base%.spl~ BEGIN
    OUTER_SET b24_un_max = b24_un_priest ? 7 : 9
    OUTER_FOR (b24_up = b24_un_level + 1; b24_up <= b24_un_max; ++b24_up) BEGIN
      OUTER_SET b24_steps = b24_up - b24_un_level
      OUTER_SPRINT b24_un_copy ~B24U%b24_un_short%%b24_up%~
      COPY_EXISTING ~%b24_un_base%.spl~ ~override/%b24_un_copy%.spl~
        WRITE_LONG 0x34 b24_up
        READ_STRREF 0x08 b24_un_name
        SAY_EVALUATED 0x08 ~%b24_un_name% (level %b24_up%)~
        PATCH_IF (b24_un_heal > 0) BEGIN
          READ_LONG  0x64 b24_hoff
          READ_LONG  0x6a b24_foff
          READ_SHORT (b24_hoff + 0x1e) b24_fnum
          READ_SHORT (b24_hoff + 0x20) b24_fidx
          FOR (k = 0; k < b24_fnum; ++k) BEGIN
            SET f = b24_foff + (b24_fidx + k) * 0x30
            READ_SHORT f b24_op
            PATCH_IF (b24_op == 402) BEGIN
              READ_LONG (f + 0x04) b24_dice
              WRITE_LONG (f + 0x04) (b24_dice + b24_steps * b24_un_heal)
            END
          END
        END
      ACTION_IF (b24_un_conc == 1) BEGIN
        APPEND ~b24conc.2da~ ~%b24_un_copy%  Spirit_Guardians~
      END
      ACTION_IF b24_un_priest BEGIN
        OUTER_SET $b24_relocate(~%b24_un_copy%~) = b24_up
      END ELSE BEGIN
        APPEND ~hidespl.2da~ ~%b24_un_copy%  1  0  0~
        APPEND ~b24upcst.2da~ ~%b24_un_copy%  %b24_un_base%  %b24_up%~
      END
    END
  END
END

// The new priest spells go into the priest lists under SPPR names too, and the table of re-filed
// spells is written for B24SPELL.lua.
ACTION_FOR_EACH b24_new_priest IN ~B24HWORD:1~ ~B24GBOLT:1~ ~B24THWVD:1~ ~B24SPGRD:3~ ~B24MHWRD:3~ ~B24REVIV:3~ ~B24ENLDR:2~ ~B24REDDR:2~ BEGIN
  OUTER_PATCH_SAVE b24_np_res ~%b24_new_priest%~ BEGIN REPLACE_TEXTUALLY ~:.*~ ~~ END
  OUTER_PATCH_SAVE b24_np_lvl ~%b24_new_priest%~ BEGIN REPLACE_TEXTUALLY ~.*:~ ~~ END
  OUTER_SET $b24_relocate(~%b24_np_res%~) = b24_np_lvl
END
LAM b24_relocate_spells

COPY ~bg2024/tables/b24upcst.2da~ ~override/b24moved.2da~
  DELETE_BYTES 0 BUFFER_LENGTH
  INSERT_BYTES 0 (STRING_LENGTH ~2DA V1.0%LNL%*%LNL%          NEW%LNL%%b24_moved_rows%~)
  WRITE_ASCIIE 0 ~2DA V1.0%LNL%*%LNL%          NEW%LNL%%b24_moved_rows%~

// Innate copies of spells (SPPR101 -> B24IP101, SPWI112 -> B24IW112): Divine Intervention, Magical
// Secrets, Spell Mastery and Signature Spells cast them as innate abilities without a spell slot
// (op171 with a priest or wizard spell only adds it to the spells known). All Cleric and Druid
// spells, wizard spells of levels 1-3. Made after the catalog changes, so they match.
COPY - ~bg2024/tables/b24spell.2da~ ~override~
  READ_2DA_ENTRIES_NOW b24_cat 9
  FOR (r = 0; r < b24_cat; ++r) BEGIN
    READ_2DA_ENTRY_FORMER b24_cat r 0 b24_res
    READ_2DA_ENTRY_FORMER b24_cat r 1 b24_action
    READ_2DA_ENTRY_FORMER b24_cat r 2 b24_level
    READ_2DA_ENTRY_FORMER b24_cat r 3 b24_lists
    SET b24_priest = ((~%b24_res%~ STRING_MATCHES_REGEXP ~SPPR[0-9][0-9][0-9]~) = 0
                      AND ((INDEX (~C~ ~%b24_lists%~) >= 0) OR (INDEX (~D~ ~%b24_lists%~) >= 0))) ? 1 : 0
    SET b24_wizard = 0
    PATCH_IF ((~%b24_res%~ STRING_MATCHES_REGEXP ~SPWI[0-9][0-9][0-9]~) = 0 AND (INDEX (~W~ ~%b24_lists%~) >= 0)
              AND IS_AN_INT b24_level) BEGIN
      SET b24_wizard = (b24_level >= 1 AND b24_level <= 3) ? 1 : 0
    END
    PATCH_IF ((b24_priest OR b24_wizard) AND (~%b24_action%~ STRING_COMPARE_CASE ~DROP~) != 0) BEGIN
      INNER_ACTION BEGIN
        ACTION_IF FILE_EXISTS_IN_GAME ~%b24_res%.spl~ BEGIN
          OUTER_PATCH_SAVE b24_copy ~%b24_res%~ BEGIN
            REPLACE_TEXTUALLY ~^SPPR~ ~B24IP~
            REPLACE_TEXTUALLY ~^SPWI~ ~B24IW~
          END
          COPY_EXISTING ~%b24_res%.spl~ ~override/%b24_copy%.spl~
            WRITE_SHORT 0x1c 4   // innate
            READ_LONG  0x64 b24_hoff
            READ_SHORT 0x68 b24_hnum
            FOR (h = 0; h < b24_hnum; ++h) BEGIN
              WRITE_BYTE (b24_hoff + h * 0x28 + 0x02) 4   // cast from the abilities
            END
        END
      END
    END
  END
// Wish (BG2) for Greater Divine Intervention: B24IW914.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi914.spl~ BEGIN
  COPY_EXISTING ~spwi914.spl~ ~override/b24iw914.spl~
    WRITE_SHORT 0x1c 4
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_BYTE (b24_hoff + h * 0x28 + 0x02) 4
    END
END

// The mod's own icons for the spells and innates made above.
LAF b24_install_icons END

// The darts and rays after the first, aimed one by one (B24SP.volleys in B24SPELL.lua): innates
// at the spell's range with one missile or ray each, granted for a round after the cast.
ACTION_FOR_EACH b24_volley IN dart ray BEGIN
  ACTION_MATCH ~%b24_volley%~ WITH
    dart BEGIN
      OUTER_SPRINT b24_res ~B24MDART~ OUTER_SPRINT b24_spell ~spwi112~ OUTER_SPRINT b24_icon ~SPWI112C~
      OUTER_SPRINT b24_fx ~B24MDARX~ OUTER_SET b24_name = RESOLVE_STR_REF (@768) OUTER_SET b24_desc = RESOLVE_STR_REF (@769)
    END
    DEFAULT
      OUTER_SPRINT b24_res ~B24SRAY~ OUTER_SPRINT b24_spell ~spwi217~ OUTER_SPRINT b24_icon ~SPWI217C~
      OUTER_SPRINT b24_fx ~B24SRAYX~ OUTER_SET b24_name = RESOLVE_STR_REF (@770) OUTER_SET b24_desc = RESOLVE_STR_REF (@771)
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_spell%.spl~ BEGIN
    COPY_EXISTING ~%b24_spell%.spl~ ~override~
      READ_LONG  0x64 b24_hoff
      READ_SHORT (b24_hoff + 0x0e) b24_volley_range
      READ_SHORT (b24_hoff + 0x26) b24_volley_proj
      BUT_ONLY
    LAF b24_create_innate INT_VAR name = b24_name description = b24_desc opcode = 402 touch = 1
      range = b24_volley_range STR_VAR resref = EVAL ~%b24_res%~ icon = EVAL ~%b24_icon%~ effect_res = EVAL ~%b24_fx%~ END
    COPY_EXISTING ~%b24_res%.spl~ ~override~
      WRITE_SHORT (0x72 + 0x26) b24_volley_proj
      BUT_ONLY
  END
END
