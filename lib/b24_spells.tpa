ACTION_IF FILE_EXISTS_IN_GAME ~spwi912.spl~ BEGIN
  COPY_EXISTING ~spwi912.spl~ ~override~
    PATCH_FOR_EACH b24_op IN 209 318 324 BEGIN
      LPF DELETE_EFFECT INT_VAR match_opcode = b24_op END
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 2 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24PWK~ END
    WRITE_LONG 0x50 RESOLVE_STR_REF (@765)
    BUT_ONLY
END
