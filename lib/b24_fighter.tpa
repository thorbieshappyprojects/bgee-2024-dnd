// Fighter component: the 2024 Fighter and the Champion (see lua/B24FIGHT.lua), and the level-up
// choices shared by the class components (lua/B24LEVEL.lua).

COPY ~bg2024/lua/M_B24FI.lua~    ~override~
     ~bg2024/lua/B24LEVEL.lua~   ~override~
     ~bg2024/lua/B24LEVEL.menu~  ~override~
     ~bg2024/lua/B24FIGHT.lua~   ~override~
// BG2:EE has no BG1 character creation window: the popup takes the window of BG2's own level-up
// choice (high-level abilities, GUIHSBS), its parts moved onto that window's panels: the name on
// top, the kind of choice in the header box above the list.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~guicgwde.mos~ AND FILE_EXISTS_IN_GAME ~guihsbs.mos~ BEGIN
  COPY_EXISTING ~B24LEVEL.menu~ ~override~
    REPLACE_TEXTUALLY EXACT_MATCH ~mosaic GUICGWDE~ ~mosaic GUIHSBS~
    REPLACE_TEXTUALLY EXACT_MATCH ~area 60 37 744 44
		text lua "B24LV_Title()"~ ~area 74 10 716 52
		text lua "B24LV_Name()"
		text style "title"
	}
	label
	{
		area 36 114 448 52
		text lua "B24LV_Choice()"~
    REPLACE_TEXTUALLY EXACT_MATCH ~area 0 0 340 44~ ~area 0 0 404 44~
    REPLACE_TEXTUALLY EXACT_MATCH ~area 52 0 288 44~ ~area 52 0 352 44~
    REPLACE_TEXTUALLY EXACT_MATCH ~area 22 100 340 490~ ~area 58 194 404 404~
    REPLACE_TEXTUALLY EXACT_MATCH ~area 380 100 456 490~ ~area 522 118 302 494~
    REPLACE_TEXTUALLY EXACT_MATCH ~area 196 653 230 40~ ~area 210 652 238 44~
    REPLACE_TEXTUALLY EXACT_MATCH ~area 438 653 230 40~ ~area 452 652 238 44~
    BUT_ONLY
END
LAF b24_menu_for_game STR_VAR file = ~B24LEVEL.menu~ END

