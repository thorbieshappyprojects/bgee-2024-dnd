COPY ~bg2024/tables/b24spell.2da~ ~override~

INCLUDE ~bg2024/lib/b24_subclass_innates.tpa~

// Travel Along the Tree (World Tree 14): BG's Dimension Door as an innate, 60 feet, granted once
// per round while raging (B24XBAR.lua); its op402 notes the use.
ACTION_IF FILE_EXISTS_IN_GAME ~spwi402.spl~ BEGIN
  COPY_EXISTING ~spwi402.spl~ ~override/b24wttrv.spl~
    SAY 0x08 @776
    SAY 0x50 @777
    WRITE_SHORT 0x1c 4
    WRITE_LONG  0x34 1
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x02) 4
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) 60
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x10) 1
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x12) 0
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 1 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24WTTRV~ END
    BUT_ONLY
END

// Epic Boon innates (B24GFEAT.lua): Recovery Dice, Spell Recall, Merge with Shadows, and
// Dimensional Travel (BG's Dimension Door, 30 feet).
LAF b24_create_innate INT_VAR name = RESOLVE_STR_REF (@778) description = RESOLVE_STR_REF (@779) opcode = 402
  STR_VAR resref = ~B24BRCVR~ icon = ~SPPR103C~ effect_res = ~B24BRCVR~ END
LAF b24_create_innate INT_VAR name = RESOLVE_STR_REF (@780) description = RESOLVE_STR_REF (@781) opcode = 402
  STR_VAR resref = ~B24BSPRC~ icon = ~SPWI105C~ effect_res = ~B24BSPRC~ END
LAF b24_create_innate INT_VAR name = RESOLVE_STR_REF (@782) description = RESOLVE_STR_REF (@783) opcode = 402
  STR_VAR resref = ~B24BNIGH~ icon = ~SPWI206C~ effect_res = ~B24BNIGH~ END
ACTION_IF FILE_EXISTS_IN_GAME ~spwi402.spl~ BEGIN
  COPY_EXISTING ~spwi402.spl~ ~override/b24bdimt.spl~
    SAY 0x08 @784
    SAY 0x50 @785
    WRITE_SHORT 0x1c 4
    WRITE_LONG  0x34 1
    READ_LONG  0x64 b24_hoff
    READ_SHORT 0x68 b24_hnum
    FOR (h = 0; h < b24_hnum; ++h) BEGIN
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x02) 4
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x0e) 30
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x10) 1
      WRITE_SHORT (b24_hoff + h * 0x28 + 0x12) 0
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 402 target = 1 timing = 0 duration = 0 probability1 = 100 STR_VAR resource = ~B24BDIMT~ END
    BUT_ONLY
END

// Soulknife: the psychic blade (a dagger made of thought: 1d6, finesse, magical, weightless).
COPY_EXISTING ~dagg01.itm~ ~override/b24psbld.itm~
  SAY 0x08 @900
  SAY 0x0c @900
  SAY 0x50 @901
  SAY 0x54 @901
  READ_LONG 0x18 b24_flags
  WRITE_LONG 0x18 (b24_flags BOR 0x40)  // magical
  WRITE_LONG 0x34 0                     // price
  WRITE_LONG 0x4c 0                     // weight
  WRITE_LONG 0x60 1                     // counts as a +1 weapon (hits creatures immune to normal weapons)
  READ_LONG  0x64 b24_hdr
  READ_SHORT 0x68 b24_hdr_n
  FOR (h = 0; h < b24_hdr_n; ++h) BEGIN
    WRITE_BYTE (b24_hdr + h * 0x38 + 0x16) 6
    WRITE_BYTE (b24_hdr + h * 0x38 + 0x18) 1
    WRITE_SHORT (b24_hdr + h * 0x38 + 0x1a) 0
  END

// Beast Master: the primal companion, a wolf per level band (2024 beast of the land: hit points
// 5 + 5 x level, AC 13 + Wisdom, attack bonus = Proficiency Bonus + Wisdom, damage +2 + Wisdom;
// Wisdom is taken as +3). band:hit points:THAC0:attacks
// Exceptional Training (Beast Master 7): the companion's attacks count as magical, a +1 copy of
// the wolf's bite (P1-4) for the bands from 7 on.
ACTION_IF FILE_EXISTS_IN_GAME ~p1-4.itm~ BEGIN
  COPY_EXISTING ~p1-4.itm~ ~override/b24bite1.itm~
    WRITE_LONG 0x18 (THIS BOR BIT6)   // magical
    WRITE_LONG 0x60 1                 // enchantment +1
END
ACTION_FOR_EACH b24_band IN ~03:20:15:1~ ~05:30:14:1~ ~07:40:14:1~ ~09:50:13:1~ ~11:60:13:2~ ~13:70:12:2~
                            ~15:80:12:2~ ~17:90:11:2~ ~19:100:11:2~ BEGIN
  OUTER_PATCH_SAVE b24_lvl ~%b24_band%~ BEGIN REPLACE_TEXTUALLY ~:.*~ ~~ END
  OUTER_PATCH_SAVE b24_hp ~%b24_band%~ BEGIN REPLACE_TEXTUALLY ~^[0-9]+:\([0-9]+\):.*~ ~\1~ END
  OUTER_PATCH_SAVE b24_thac0 ~%b24_band%~ BEGIN REPLACE_TEXTUALLY ~^[0-9]+:[0-9]+:\([0-9]+\):.*~ ~\1~ END
  OUTER_PATCH_SAVE b24_apr ~%b24_band%~ BEGIN REPLACE_TEXTUALLY ~.*:~ ~~ END
  COPY_EXISTING ~wolfsu.cre~ ~override/b24bst%b24_lvl%.cre~
    SAY 0x08 @902
    SAY 0x0c @902
    WRITE_LONG  0x14 0                  // no experience for killing it
    WRITE_SHORT 0x24 b24_hp
    WRITE_SHORT 0x26 b24_hp
    WRITE_SHORT 0x46 4                  // AC 16 in 2024 terms
    WRITE_SHORT 0x48 4
    WRITE_BYTE  0x52 b24_thac0
    WRITE_BYTE  0x53 b24_apr
    WRITE_BYTE  0x234 b24_lvl
    LPF ADD_CRE_EFFECT INT_VAR opcode = 73 target = 1 parameter1 = 5 timing = 9 END
    PATCH_IF (b24_lvl >= 7) AND FILE_EXISTS_IN_GAME ~b24bite1.itm~ BEGIN
      REPLACE_CRE_ITEM ~b24bite1~ #0 #0 #0 ~none~ ~WEAPON1~ EQUIP
    END
END


// The base druid's 2e passives (poison immunity at 15, elemental resistances at 18, 21 and 24)
// are not 2024 Druid features, and BG's shapeshifting (wolf, black and brown bear from level 7)
// makes way for the 2024 Wild Shape below. B24DRUID.lua takes them from existing druids.
ACTION_IF FILE_EXISTS_IN_GAME ~clabdr01.2da~ BEGIN
  COPY_EXISTING_REGEXP GLOB ~^clabdr0[0-9]\.2da$~ ~override~
    REPLACE_TEXTUALLY CASE_INSENSITIVE ~AP_SPCL92[4-7]~ ~****~
    REPLACE_TEXTUALLY CASE_INSENSITIVE ~GA_SPCL61[1-3]~ ~****~
    BUT_ONLY
END

// 2024 Wild Shape (B24DRUID.lua): every row of B24WSHAP.2DA is a beast form. Its innate (B24WF...,
// from tools/subclass_innates.txt) calls the Lua function of the same name, which gives the druid
// the form's claws (B24WI..., an op111 weapon) for the form's duration. The claws hold the look
// (op135 appearance of B24WC..., a copy of the wolf with the form's animation), the attacks per
// round and resistances; the Lua side sets the beast's scores, AC and attack bonus. The Wild Shape
// innate (B24WSHAP) opens the list of the forms up to the druid's tier (op214 over B24WSL1-4.2DA).
COPY ~bg2024/tables/b24wshap.2da~ ~override/b24wshap.2da~
COPY_EXISTING ~b24wshap.2da~ ~override~
  READ_2DA_ENTRIES_NOW b24_ws 18          // the form rows (the column header has 17 entries)
BUT_ONLY
OUTER_FOR (b24_t = 1; b24_t <= 4; ++b24_t) BEGIN
  OUTER_TEXT_SPRINT b24_ws_list ~2DA V1.0%LNL%*%LNL%           ResRef     Type%LNL%~
  OUTER_FOR (r = 0; r < b24_ws; ++r) BEGIN
    OUTER_SPRINT b24_ws_key $b24_ws(~%r%~ ~0~)
    OUTER_SPRINT b24_ws_res $b24_ws(~%r%~ ~1~)
    OUTER_SET b24_ws_tier = $b24_ws(~%r%~ ~2~)
    ACTION_IF b24_ws_tier <= b24_t BEGIN
      OUTER_TEXT_SPRINT b24_ws_list ~%b24_ws_list%%b24_ws_key%  %b24_ws_res%  3%LNL%~
    END
  END
  COPY_EXISTING ~b24wshap.2da~ ~override/b24wsl%b24_t%.2da~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 (STRING_LENGTH ~%b24_ws_list%~)
    WRITE_ASCIIE 0 ~%b24_ws_list%~
END
OUTER_FOR (r = 0; r < b24_ws; ++r) BEGIN
  OUTER_SPRINT b24_ws_res $b24_ws(~%r%~ ~1~)
  OUTER_PATCH_SAVE b24_ws_id ~%b24_ws_res%~ BEGIN DELETE_BYTES 0 5 END // B24WFWOL -> WOL
  OUTER_SET b24_ws_anim = $b24_ws(~%r%~ ~3~)
  OUTER_SET b24_ws_str = $b24_ws(~%r%~ ~6~)
  OUTER_SPRINT b24_ws_dice $b24_ws(~%r%~ ~10~)
  OUTER_SET b24_ws_bonus = $b24_ws(~%r%~ ~11~)
  OUTER_SET b24_ws_type = $b24_ws(~%r%~ ~12~)
  OUTER_SET b24_ws_apr = $b24_ws(~%r%~ ~13~)
  OUTER_SPRINT b24_ws_resist $b24_ws(~%r%~ ~17~)
  OUTER_PATCH_SAVE b24_ws_count ~%b24_ws_dice%~ BEGIN REPLACE_TEXTUALLY ~d.*~ ~~ END
  OUTER_PATCH_SAVE b24_ws_size ~%b24_ws_dice%~ BEGIN REPLACE_TEXTUALLY ~.*d~ ~~ END
  // The engine adds the Strength modifier (STRMOD.2DA) to the damage; the claws hold the rest.
  OUTER_SET b24_ws_strmod = (b24_ws_str - 10) / 2   // every form has Strength 10 or more
  COPY_EXISTING ~wolfsu.cre~ ~override/b24wc%b24_ws_id%.cre~
    WRITE_LONG 0x28 b24_ws_anim
  COPY_EXISTING ~p1-4.itm~ ~override/b24wi%b24_ws_id%.itm~
    SAY 0x08 @992
    SAY 0x0c @992
    WRITE_LONG 0x60 0                     // no enchantment: beast attacks aren't magical
    READ_LONG  0x64 b24_hdr
    WRITE_SHORT (b24_hdr + 0x16) b24_ws_size
    WRITE_SHORT (b24_hdr + 0x18) b24_ws_count
    WRITE_SHORT (b24_hdr + 0x1a) (b24_ws_bonus - b24_ws_strmod)
    WRITE_SHORT (b24_hdr + 0x1c) b24_ws_type
    LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 135 target = 1 timing = 2 parameter2 = 1 STR_VAR resource = EVAL ~b24wc%b24_ws_id%~ END
    LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 1 target = 1 timing = 2 parameter1 = b24_ws_apr parameter2 = 1 END
    PATCH_IF (~%b24_ws_resist%~ STRING_EQUAL_CASE ~COLD~) BEGIN
      LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 28 target = 1 timing = 2 parameter1 = 50 END
    END
END

// BG kits (B24KITS.2DA): their 2e kit abilities make way for the 2024 class and subclass features.
// Entries a kit shares with its base class table (Set Traps, Shapeshift, ...) stay. What is removed
// is listed in B24KITAB.2DA, so the runtime can take it from existing characters and companions
// (B24LEVEL.lua); kits with a PHB 2024 counterpart are that subclass.
COPY ~bg2024/tables/b24kits.2da~ ~override~

ACTION_DEFINE_ASSOCIATIVE_ARRAY b24_base_clab BEGIN
  2 => CLABFI01  3 => CLABPR01  4 => CLABTH01  5 => CLABBA01  6 => CLABPA01  11 => CLABDR01
  12 => CLABRN01  20 => CLABMO01  21 => CLABSH01
END

// Abilities of the base class tables.
ACTION_PHP_EACH b24_base_clab AS b24_class => b24_table BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_table%.2da~ BEGIN
    COPY_EXISTING ~%b24_table%.2da~ ~override~
      REPLACE_EVALUATE CASE_INSENSITIVE ~\(AP\|GA\)_\([A-Z0-9_#]+\)~ BEGIN
        TEXT_SPRINT b24_res ~%MATCH2%~
        TO_UPPER b24_res
        SET $b24_base_has(~%b24_table%~ ~%b24_res%~) = 1
      END ~%MATCH0%~
      BUT_ONLY
  END
END

COPY_EXISTING ~b24kits.2da~ ~override~
  READ_2DA_ENTRIES_NOW b24_kitmap 4
  FOR (r = 0; r < b24_kitmap; ++r) BEGIN
    READ_2DA_ENTRY_FORMER b24_kitmap r 0 b24_kit
    READ_2DA_ENTRY_FORMER b24_kitmap r 3 b24_kitsub
    TO_UPPER b24_kit
    INNER_PATCH_SAVE b24_kitsub ~%b24_kitsub%~ BEGIN REPLACE_TEXTUALLY ~_~ ~ ~ END
    TEXT_SPRINT $b24_kit_subclass(~%b24_kit%~) ~%b24_kitsub%~
  END
  BUT_ONLY

OUTER_TEXT_SPRINT b24_kitab ~2DA V1.0%LNL%*%LNL%       KIT                RES%LNL%~
OUTER_SET b24_kitab_n = 0
COPY_EXISTING ~kitlist.2da~ ~override~
  READ_2DA_ENTRIES_NOW b24_kits 10
  FOR (r = 0; r < b24_kits; ++r) BEGIN
    READ_2DA_ENTRY_FORMER b24_kits r 1 b24_kit
    READ_2DA_ENTRY_FORMER b24_kits r 4 b24_help
    READ_2DA_ENTRY_FORMER b24_kits r 5 b24_abil
    READ_2DA_ENTRY_FORMER b24_kits r 8 b24_class
    TO_UPPER b24_kit
    TO_UPPER b24_abil
    // Wilson's bear kit belongs to a creature, not a character kit.
    PATCH_IF (IS_AN_INT b24_class) AND NOT (~%b24_abil%~ STRING_EQUAL ~*~) AND NOT (~%b24_kit%~ STRING_EQUAL ~BARBARIAN~)
      AND NOT (~%b24_kit%~ STRING_EQUAL ~GRIZZLY_BEAR~) BEGIN
      TEXT_SPRINT $b24_kit_table(~%b24_kit%~) ~%b24_abil%~
      SET $b24_kit_class(~%b24_kit%~) = b24_class
      // The kit description gets a note on what the kit is now.
      PATCH_IF (IS_AN_INT b24_help) AND (b24_help > 0) BEGIN
        GET_STRREF b24_help b24_text
        PATCH_IF VARIABLE_IS_SET $b24_kit_subclass(~%b24_kit%~) BEGIN
          TEXT_SPRINT b24_sub $b24_kit_subclass(~%b24_kit%~)
          SPRINT b24_note @910
        END ELSE BEGIN
          SPRINT b24_note @911
        END
        PATCH_IF (INDEX (~BG 2024:~ ~%b24_text%~) < 0) BEGIN
          SET b24_new = RESOLVE_STR_REF (~%b24_text%%LNL%%LNL%%b24_note%~)
          SET_2DA_ENTRY_LATER b24_kitset r 4 b24_new
        END
      END
    END
  END
  SET_2DA_ENTRIES_NOW b24_kitset 10
  BUT_ONLY

ACTION_PHP_EACH b24_kit_table AS b24_kit => b24_abil BEGIN
  OUTER_SET b24_class = $b24_kit_class(~%b24_kit%~)
  OUTER_TEXT_SPRINT b24_base ~~
  ACTION_IF VARIABLE_IS_SET $b24_base_clab(~%b24_class%~) BEGIN
    OUTER_TEXT_SPRINT b24_base $b24_base_clab(~%b24_class%~)
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_abil%.2da~ AND NOT (~%b24_abil%~ STRING_EQUAL_CASE ~%b24_base%~) BEGIN
    COPY_EXISTING ~%b24_abil%.2da~ ~override~
      REPLACE_EVALUATE CASE_INSENSITIVE ~\(AP\|GA\)_\([A-Z0-9_#]+\)~ BEGIN
        TEXT_SPRINT b24_res ~%MATCH2%~
        TO_UPPER b24_res
        PATCH_IF VARIABLE_IS_SET $b24_base_has(~%b24_base%~ ~%b24_res%~) BEGIN
          TEXT_SPRINT b24_keep ~%MATCH0%~
        END ELSE BEGIN
          TEXT_SPRINT b24_keep ~****~
          PATCH_IF NOT VARIABLE_IS_SET $b24_kitab_seen(~%b24_kit%~ ~%b24_res%~) BEGIN
            SET $b24_kitab_seen(~%b24_kit%~ ~%b24_res%~) = 1
            SET b24_kitab_n += 1
            TEXT_SPRINT b24_kitab ~%b24_kitab%%b24_kitab_n%      %b24_kit%      %b24_res%%LNL%~
          END
        END
      END ~%b24_keep%~
      BUT_ONLY
  END
END

COPY_EXISTING ~b24kits.2da~ ~override/b24kitab.2da~
  DELETE_BYTES 0 BUFFER_LENGTH
  INSERT_BYTES 0 (STRING_LENGTH ~%b24_kitab%~)
  WRITE_ASCIIE 0 ~%b24_kitab%~

// The mod's own icons for the spells and innates made above.
LAF b24_install_icons END
