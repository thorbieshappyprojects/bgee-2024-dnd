// The 2e class abilities of monks, paladins and rangers make way for the 2024 features.
ACTION_FOR_EACH b24_clab IN ~clabmo01~ ~clabpa01~ ~clabrn01~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%b24_clab%.2da~ BEGIN
    COPY_EXISTING ~%b24_clab%.2da~ ~override~
      REPLACE_TEXTUALLY ~\(AP\|GA\)_[A-Z0-9_#]+~ ~****~
      BUT_ONLY
  END
END

// Monk fists follow the Martial Arts die: d6, d8 at 5, d10 at 11, d12 at 17; magical from level 6
// (Empowered Strikes). BG's fists are the template.
ACTION_IF FILE_EXISTS_IN_GAME ~mfist1.itm~ BEGIN
  ACTION_FOR_EACH b24_fist IN ~B24MF6:6:0~ ~B24MF8N:8:0~ ~B24MF8:8:1~ ~B24MF10:10:1~ ~B24MF12:12:1~ BEGIN
    OUTER_PATCH_SAVE b24_res ~%b24_fist%~ BEGIN REPLACE_TEXTUALLY ~:.*~ ~~ END
    OUTER_PATCH_SAVE b24_die ~%b24_fist%~ BEGIN REPLACE_TEXTUALLY ~^[A-Z0-9]+:\([0-9]+\):.*~ ~\1~ END
    OUTER_PATCH_SAVE b24_magic ~%b24_fist%~ BEGIN REPLACE_TEXTUALLY ~.*:~ ~~ END
    COPY_EXISTING ~mfist1.itm~ ~override/%b24_res%.itm~
      WRITE_LONG 0x60 b24_magic
      READ_LONG  0x64 b24_hdr
      READ_SHORT 0x68 b24_hdr_n
      FOR (h = 0; h < b24_hdr_n; ++h) BEGIN
        WRITE_SHORT (b24_hdr + h * 0x38 + 0x14) 0
        WRITE_BYTE  (b24_hdr + h * 0x38 + 0x16) b24_die
        WRITE_BYTE  (b24_hdr + h * 0x38 + 0x18) 1
        WRITE_SHORT (b24_hdr + h * 0x38 + 0x1a) 0
      END
  END
  COPY_EXISTING ~monkfist.2da~ ~override~
    // The default entry (levels beyond the rows) is the d12 fist too.
    REPLACE_TEXTUALLY ~^MFIST[0-9]+~ ~B24MF12~
    COUNT_2DA_ROWS 2 b24_rows
    FOR (r = 0; r < b24_rows; ++r) BEGIN
      READ_2DA_ENTRY r 0 2 b24_level
      PATCH_IF (IS_AN_INT b24_level) BEGIN
        TEXT_SPRINT b24_res ~B24MF12~
        PATCH_IF (b24_level <= 16) BEGIN TEXT_SPRINT b24_res ~B24MF10~ END
        PATCH_IF (b24_level <= 10) BEGIN TEXT_SPRINT b24_res ~B24MF8~ END
        PATCH_IF (b24_level <= 5) BEGIN TEXT_SPRINT b24_res ~B24MF8N~ END
        PATCH_IF (b24_level <= 4) BEGIN TEXT_SPRINT b24_res ~B24MF6~ END
        SET_2DA_ENTRY r 1 2 ~%b24_res%~
      END
    END
    BUT_ONLY
END

