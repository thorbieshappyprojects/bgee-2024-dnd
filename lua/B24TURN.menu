-- BG 2024 Rules Mod: turn-based combat on the game screen (B24TURN.lua keeps these menus there
-- while the game screen is up). BG2:EE gets its own button art (b24_menu_for_game).

-- The switch while enemies are in sight, and End Turn while a party member has its turn (below the
-- initiative bar).
menu
{
	name 'B24_TURNBUTTON'
	align left top
	ignoreesc

	button
	{
		area 80 100 230 40
		enabled "B24TB.ButtonShown()"
		bam GUIBUTMT
		text lua "B24TB.ButtonText()"
		text style "button"
		tooltip lua "B24TB.ButtonTooltip()"
		action "B24TB.ToggleButton()"
	}
	button
	{
		area 80 144 230 40
		enabled "B24TB.EndTurnShown()"
		bam GUIBUTMT
		text lua "B24TB.EndTurnText()"
		text style "button"
		action "B24TB.EndTurnButton()"
	}
}

-- The initiative order (B24TB.Tracker*): the round, then the order as it stands. Party members show
-- their portrait, everyone else a tile with the name; the gold frame marks whose turn it is, the
-- party has green tiles, the others red ones. Top left the place in the order, top right the
-- initiative rolled; in the middle of the tiles without a portrait, notes (B24TB.TrackerNote).
menu
{
	name 'B24_TURNTRACKER'
	align center top
	ignoreesc

	label
	{
		area 0 8 80 80
		enabled "B24TB.TrackerShown(1)"
		fill 20 16 12 220
		text lua "B24TB.RoundText()"
		text style "normal"
		text align center center
	}
	label
	{
		area 82 6 78 84
		enabled "B24TB.TrackerCurrent(1)"
		fill 200 160 60 255
	}
	label
	{
		area 84 8 74 80
		enabled "B24TB.TrackerParty(1)"
		fill 24 48 24 230
	}
	label
	{
		area 84 8 74 80
		enabled "B24TB.TrackerOther(1)"
		fill 64 18 14 230
	}
	label
	{
		area 102 10 38 60
		enabled "B24TB.TrackerPortrait(1) ~= ''"
		bitmap lua "B24TB.TrackerPortrait(1)"
	}
	label
	{
		area 84 70 74 18
		enabled "B24TB.TrackerShown(1)"
		text lua "B24TB.TrackerName(1)"
		text style "normal"
		text align center center
